# Copy to .env in this folder (git-ignored) and fill it in. Values are read by docker-compose.yml.
# Avoid $ ; ' and " in the passwords: they go into connection strings and compose substitutes $.

# The address the courier is served at, without https:// (a domain or subdomain whose A record points at this server,
# or, with no domain, <server-ip-with-dashes>.sslip.io, e.g. 203-0-113-5.sslip.io)
SITE_ADDRESS=courier.example.com

# SQL Server's sa password: at least 8 characters from three of upper case, lower case, digits and symbols
SA_PASSWORD=

# The courier's admin, created on the first start. After the first sign-in, change the password at
# /Account/Password and empty ADMIN_PASSWORD here: an admin who already exists is never changed.
ADMIN_EMAIL=
ADMIN_NAME=
# At least 8 characters with an upper case letter, a lower case letter and a digit
ADMIN_PASSWORD=

# Optional: a mail server for merchants' payout emails (Gmail: smtp.gmail.com, port 587 and an app password).
# Left empty, no email is sent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=OneDrop Courier

# Optional: an SSLCommerz store, so merchants can pay what they owe online. A sandbox store takes test payments only.
# Left empty, the "Pay online" button is not offered.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com/

# Optional: a Google Maps browser key, for the map merchants pin the recipient's door on and the small maps on parcel
# pages. In Google Cloud turn on Maps JavaScript API, Places API (New), Geocoding API and Maps Embed API, and restrict
# the key to https://<SITE_ADDRESS>/*. Left empty, merchants paste a Google Maps link instead and riders still get
# directions.
GOOGLE_MAPS_API_KEY=
