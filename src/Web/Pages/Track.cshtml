@page
@model TrackModel
@inject ITenantContext TenantContext
@{
    ViewData["Title"] = Model.Parcel is null ? "Track a parcel" : $"Parcel {Model.Parcel.TrackingCode}";
}

<section class="hero">
    <div class="site-section" style="max-width:780px">
        <span class="eyebrow">Parcel tracking</span>
        <h1>Where is my parcel?</h1>
        <p class="lead">Enter the tracking code from your SMS or the parcel's label.</p>
        <form class="hero-track" method="get" role="search">
            <input type="text" name="code" value="@Model.Code" placeholder="Enter your tracking code" aria-label="Tracking code" required />
            <button class="btn btn-primary" type="submit">@Icons.Get("search") Track</button>
        </form>
    </div>
</section>

<section class="site-section" style="max-width:780px;padding-top:32px">
    @if (Model.Problem is not null)
    {
        <div class="alert alert-error">@Icons.Get("alert")<div>@Model.Problem</div></div>
    }

    @if (Model.Parcel is { } parcel)
    {
        var next = parcel.Status switch
        {
            ParcelStatus.Pending => ("clock", "The shop has booked your parcel. A rider collects it from them soon."),
            ParcelStatus.PickedUp or ParcelStatus.AtHub or ParcelStatus.InTransit => ("truck", "Your parcel is with us and on its way to the hub nearest you."),
            ParcelStatus.OutForDelivery => ("bike", "A rider is bringing it to you today. Keep your phone near you in case the rider calls."),
            ParcelStatus.OnHold => ("calendar", "We could not deliver it this time. A rider tries again; the shop can tell you more."),
            ParcelStatus.Delivered or ParcelStatus.PartlyDelivered => ("check-circle", "Delivered. Thank you for receiving it."),
            ParcelStatus.Returning or ParcelStatus.Returned => ("return", "This parcel is going back to the shop. Contact them if you still want it."),
            _ => ("x-circle", "The shop cancelled this parcel before it was sent.")
        };
        <div class="card">
            <div class="card-head">
                <div>
                    <h2 class="mono" style="display:flex;align-items:center;gap:6px">
                        @parcel.TrackingCode
                        <button type="button" class="btn btn-ghost btn-sm" data-copy="@parcel.TrackingCode" title="Copy the tracking code" aria-label="Copy the tracking code" style="padding:0 8px">@Icons.Get("copy")</button>
                    </h2>
                    <p>From @parcel.Merchant to @parcel.Area, @parcel.City · booked @parcel.Booked.ToString("d MMM yyyy")</p>
                </div>
                @Statuses.Badge(parcel.Status)
            </div>
            <div class="card-body">
                <partial name="_ParcelProgress" model="parcel.Status" />
                <div class="alert alert-info mt" style="margin-bottom:0">
                    @Icons.Get(next.Item1)
                    <div>
                        @next.Item2
                        @if (parcel.ExpectedBy is { } expected)
                        {
                            <div style="margin-top:6px"><strong>Expected by @expected.ToString("dddd d MMMM").</strong>@(expected < TenantContext.Require().Today(DateTime.UtcNow) ? " It is running late; the hub sends late parcels out first." : "")</div>
                        }
                    </div>
                </div>
                @if (parcel.PaidOnline)
                {
                    <div class="alert alert-success mt" style="margin-bottom:0">@Icons.Get("check-circle")<div><strong>Paid online.</strong> There is nothing to pay the rider.</div></div>
                }
                else if (parcel.PayOnline)
                {
                    <div class="alert alert-info mt" style="margin-bottom:0">
                        @Icons.Get("wallet")
                        <div>
                            <strong>Pay before it arrives?</strong> Pay the cash on delivery online with bKash, Nagad or a card, and give the rider nothing at the door.
                            <div style="margin-top:8px"><a class="btn btn-primary btn-sm" asp-page="/Track/Pay" asp-route-code="@parcel.TrackingCode">Pay online</a></div>
                        </div>
                    </div>
                }
                <hr />
                <ol class="timeline">
                    @foreach (var step in parcel.Steps)
                    {
                        <li>
                            <span class="dot"></span>
                            <div class="tl-title">@step.Note</div>
                            <div class="tl-meta">@step.When.ToString("ddd d MMM, h:mm tt")@(step.Hub is null ? "" : $" · {step.Hub}")</div>
                        </li>
                    }
                </ol>
            </div>
        </div>
    }
</section>
