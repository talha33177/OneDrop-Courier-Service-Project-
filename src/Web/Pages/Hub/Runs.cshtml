@page
@using Domain.Delivery
@model Web.Pages.Hub.RunsModel
@{
    ViewData["Title"] = "Rider closing";
}

<div class="page-head">
    <div>
        <h1>Rider closing</h1>
        <p>At the end of the day count each rider's cash and take back the parcels they could not deliver. A run still open after its rider was due back is marked late: call the rider.</p>
    </div>
    <div class="page-actions">@await Html.PartialAsync("_HubSwitch", Model)</div>
</div>

<partial name="_Alerts" />

<div class="tip" data-tip="hub-runs">
    @Icons.Get("bulb")
    <div>
        <div class="tip-title">Closing a rider's day</div>
        <ol>
            <li>The rider records every parcel on their phone</li>
            <li>Count the cash they hand in and enter it</li>
            <li>Close the run: parcels not delivered go back on the shelf, the cash joins the hub's, and a shortfall goes to the hub manager</li>
        </ol>
    </div>
</div>

<div class="card">
    @if (Model.Runs.Count == 0)
    {
        <div class="empty">@Icons.Get("bike")<h3>No runs today</h3><p>A run opens when parcels are assigned to a rider.</p></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>Rider</th><th>Day</th><th class="num">Parcels</th><th class="num">Delivered</th><th class="num">Back</th><th class="num">Still out</th><th class="num">Cash collected</th><th>Closing</th></tr></thead>
                <tbody>
                    @foreach (var run in Model.Runs)
                    {
                        <tr>
                            <td>
                                <div class="cell-main">@run.Rider</div>
                                <div class="cell-sub">@Money.Phone(run.RiderPhone)</div>
                                @if (run.WithoutOutcome > 0)
                                {
                                    <a class="cell-sub" asp-page="/Hub/RunSheet" asp-route-id="@run.Id" asp-route-hub="@Model.Hub?.Code">@Icons.Get("printer") Run sheet</a>
                                }
                            </td>
                            <td class="nowrap">
                                @run.Date.ToString("ddd d MMM")
                                @if (run.Status == RunStatus.Open && run.DueBack is { } due)
                                {
                                    <div><span class="due @(run.Late ? "late" : "")">@(run.Late ? "Late, due back" : "Back by") @due.ToString(run.Late ? "ddd h:mm tt" : "h:mm tt")</span></div>
                                }
                            </td>
                            <td class="num">@run.Assigned</td>
                            <td class="num positive">@run.Delivered</td>
                            <td class="num">@(run.Held + run.Refused)<div class="cell-sub">@run.Held held, @run.Refused refused</div></td>
                            <td class="num @(run.WithoutOutcome > 0 ? "strong" : "faint")">@run.WithoutOutcome</td>
                            <td class="num strong">@Money.Taka(run.CashCollected)</td>
                            <td>
                                @if (run.Status == RunStatus.Closed)
                                {
                                    @Statuses.Badge(run.Status)
                                    <div class="cell-sub">
                                        @Money.Taka(run.CashReceived) received
                                        @if (run.Short is { } shortBy && shortBy != 0)
                                        {
                                            <span class="@(shortBy > 0 ? "negative" : "positive")"> · @(shortBy > 0 ? "short" : "over") @Money.Taka(Math.Abs(shortBy))</span>
                                        }
                                    </div>
                                }
                                else if (run.WithoutOutcome > 0)
                                {
                                    <span class="badge badge-out">Rider still out</span>
                                    <div class="cell-sub">@run.WithoutOutcome to record on their phone</div>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Close" asp-route-id="@run.Id" asp-route-hub="@Model.Hub?.Code" class="gap" data-expected="@run.CashCollected.ToString("0")" data-rider="@run.Rider">
                                        <div class="input-group" style="width:150px">
                                            <span class="prefix">৳</span>
                                            <input type="number" name="received" value="@run.CashCollected.ToString("0")" min="0" step="1" style="height:32px" aria-label="Cash received" required />
                                        </div>
                                        <button class="btn btn-primary btn-sm" type="submit">Close run</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Closing with less cash than the rider collected is allowed (the shortfall is recorded) but asked about first
        for (const form of document.querySelectorAll("form[data-expected]")) {
            const input = form.querySelector("input[name=received]");
            const check = () => {
                const short = Number(form.dataset.expected) - Number(input.value || 0);
                if (short > 0) {
                    form.dataset.confirm = `${form.dataset.rider} hands in ৳${short.toLocaleString("en-US")} less than they collected. The shortfall waits on the Cash page for the hub manager to accept.`;
                    form.dataset.confirmTitle = "Close with cash short?";
                    form.dataset.confirmOk = "Close run anyway";
                } else {
                    delete form.dataset.confirm;
                }
            };
            input.addEventListener("input", check);
            check();
        }
    </script>
}
