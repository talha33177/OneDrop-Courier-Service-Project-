@page
@using Domain.Delivery
@model Web.Pages.Hub.AssignModel
@inject ITenantContext TenantContext
@{
    ViewData["Title"] = "Assign to riders";
    var areas = Model.Waiting.Select(p => p.Area).Distinct().Order().ToList();
    var shown = Model.Area is null ? Model.Waiting : Model.Waiting.Where(p => p.Area == Model.Area).ToList();
    var tenant = TenantContext.Require();
    var today = tenant.Today(DateTime.UtcNow);
    var late = shown.Count(p => p.DueOn < today);
    // The heaviest parcel any rider of this hub can take; a parcel above it needs a bigger vehicle than the hub has
    var heaviestTaken = Model.Riders.Count == 0 || Model.Riders.Any(r => r.MaxParcelGrams is null)
        ? int.MaxValue
        : Model.Riders.Max(r => r.MaxParcelGrams!.Value);
}

<div class="page-head">
    <div>
        <h1>Assign to riders</h1>
        <p>Tick the parcels a rider takes out now and choose the rider. They go on the rider's run sheet for today@(tenant.RiderReturnTime is { } back ? $", to be done and back at the hub by {back:h:mm tt}" : "").</p>
    </div>
    <div class="page-actions">@await Html.PartialAsync("_HubSwitch", Model)</div>
</div>

<partial name="_Alerts" />

<div class="tip" data-tip="hub-assign">
    @Icons.Get("bulb")
    <div>
        <div class="tip-title">Three steps</div>
        <ol>
            <li>Filter by area to keep a rider's route together</li>
            <li>Tick the parcels: the late ones are at the top, in red</li>
            <li>Choose a rider with room on their vehicle and hand them over</li>
        </ol>
    </div>
</div>

<div class="grid grid-side">
    <div class="card">
        <div class="card-head">
            <div><h2>Waiting for a rider</h2><p>@Model.Waiting.Count parcel@(Model.Waiting.Count == 1 ? "" : "s") at this hub for its areas, the most urgent first@(late > 0 ? $" · {late} late" : "")</p></div>
        </div>
        @if (areas.Count > 1)
        {
            <div class="filters">
                <div class="pill-row">
                    <a class="pill @(Model.Area is null ? "active" : "")" asp-route-hub="@Model.Hub?.Code">All areas · @Model.Waiting.Count</a>
                    @foreach (var area in areas)
                    {
                        <a class="pill @(Model.Area == area ? "active" : "")" asp-route-hub="@Model.Hub?.Code" asp-route-area="@area">@area · @Model.Waiting.Count(p => p.Area == area)</a>
                    }
                </div>
            </div>
        }
        <form method="post" asp-route-hub="@Model.Hub?.Code" id="assign">
            @if (shown.Count == 0)
            {
                <div class="empty">@Icons.Get("check-circle")<h3>Nothing waiting</h3><p>Scan parcels in first; those delivered from this hub show up here.</p><a class="btn btn-outline" asp-page="/Hub/Scan" asp-route-hub="@Model.Hub?.Code">@Icons.Get("scan") Scan parcels in</a></div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table compact">
                        <thead><tr><th class="check-col"><input type="checkbox" data-select-all aria-label="Select all" title="Select every parcel due today" /></th><th>Parcel</th><th>Recipient</th><th>Area</th><th>Status</th><th class="num">Weight</th><th class="num">COD</th></tr></thead>
                        <tbody>
                            @foreach (var p in shown)
                            {
                                var later = p.HoldUntil is { } day && day > today;
                                var tooHeavy = p.WeightGrams > heaviestTaken;
                                <tr class="@(later || p.Issue is not null || tooHeavy ? "later" : "")">
                                    <td class="check-col">
                                        @if (tooHeavy)
                                        {
                                            <span title="Heavier than any rider's vehicle takes">@Icons.Get("alert")</span>
                                        }
                                        else if (p.Issue is null)
                                        {
                                            <input type="checkbox" name="codes" value="@p.TrackingCode" aria-label="Select @p.TrackingCode" data-later="@(later ? "true" : null)" data-grams="@p.WeightGrams" />
                                        }
                                        else
                                        {
                                            <span title="Flagged: clear it on the parcel's page first">@Icons.Get("flag")</span>
                                        }
                                    </td>
                                    <td><a class="code-link" asp-page="/Hub/Parcel" asp-route-code="@p.TrackingCode">@p.TrackingCode</a><div class="cell-sub">@p.Merchant</div><div class="tag-row">@Statuses.Tags(p.Tags)</div></td>
                                    <td>@p.RecipientName</td>
                                    <td>@p.Area</td>
                                    <td>
                                        @Statuses.Badge(p.Status)
                                        @if (p.Attempts > 0)
                                        {
                                            <div class="cell-sub">@p.Attempts attempt@(p.Attempts == 1 ? "" : "s")@(p.Reason is null ? "" : $": {p.Reason}")</div>
                                        }
                                        @if (tooHeavy)
                                        {
                                            <div class="row-note">@Icons.Get("alert") @Money.Kg(p.WeightGrams) is more than any vehicle of this hub takes (@Money.Kg(heaviestTaken)): ask an admin to add a rider on a pickup van or raise the limit under Vehicles</div>
                                        }
                                        else if (p.Issue is { } issue)
                                        {
                                            <div class="row-note">@Statuses.Badge(issue) @p.IssueNote: stays here until the flag is cleared</div>
                                        }
                                        else if (later)
                                        {
                                            <div class="row-note">@Icons.Get("calendar") Customer asked for @p.HoldUntil!.Value.ToString("ddd d MMM")</div>
                                        }
                                        else
                                        {
                                            <div>@Statuses.Due(p.DueOn, p.Status, today)</div>
                                        }
                                    </td>
                                    <td class="num nowrap">@Money.Kg(p.WeightGrams)</td>
                                    <td class="num">@Money.Taka(p.CodAmount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </form>
    </div>

    <div class="card sticky-card">
        <div class="card-head">
            <h2>@Icons.Get("bike") Hand to</h2>
            <span class="selection-count" data-selected title="Parcels ticked">0</span>
        </div>
        <div class="card-body">
            @if (Model.Riders.Count == 0)
            {
                <div class="empty" style="padding:20px 0">@Icons.Get("users")<h3>No active riders</h3><p>An admin adds riders for this hub under Riders.</p></div>
            }
            else
            {
                <div class="stack">
                    @foreach (var rider in Model.Riders)
                    {
                        var parcelShare = rider.MaxParcels is { } most ? Math.Min(100, 100 * rider.WithThem / most) : 0;
                        var weightShare = rider.MaxLoadGrams is { } heaviest ? Math.Min(100, (int)(100L * rider.CarriedGrams / heaviest)) : 0;
                        var share = Math.Max(parcelShare, weightShare);
                        <label class="radio-card" style="display:flex;justify-content:space-between;align-items:center;gap:10px">
                            <span style="display:flex;gap:10px;align-items:center">
                                <input type="radio" name="riderId" value="@rider.Id" form="assign" required
                                       data-name="@rider.Name" data-vehicle="@rider.Vehicle.DisplayName().ToLowerInvariant()"
                                       data-room-parcels="@(rider.MaxParcels - rider.WithThem)" data-room-grams="@(rider.MaxLoadGrams - rider.CarriedGrams)"
                                       data-max-parcel="@rider.MaxParcelGrams" data-with="@rider.WithThem" data-carried="@rider.CarriedGrams"
                                       data-max="@rider.MaxParcels" data-load="@rider.MaxLoadGrams" />
                                <span class="avatar" style="width:32px;height:32px;font-size:12px">@string.Concat(rider.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])))</span>
                                <span>@rider.Name<small><span class="vehicle">@Icons.Get(Statuses.Icon(rider.Vehicle)) @rider.Vehicle.DisplayName()</span> · @rider.DeliveredToday delivered today</small></span>
                            </span>
                            <span class="load" title="What @rider.Name carries now">
                                @if (rider.MaxParcels is { } max && rider.MaxLoadGrams is { } load)
                                {
                                    <span data-load-text>@rider.WithThem/@max · @Money.Kg(rider.CarriedGrams) of @Money.Kg(load)</span>
                                    <span class="meter @(share >= 100 ? "full" : share >= 80 ? "warn" : "")" data-load-meter><span style="width:@share%"></span></span>
                                }
                                else
                                {
                                    <span>@rider.WithThem with them</span>
                                }
                            </span>
                        </label>
                    }
                </div>
                <p class="hint warn" data-room hidden></p>
                <button class="btn btn-primary btn-lg btn-block mt" type="submit" form="assign" data-hand-over>@Icons.Get("send") <span>Hand over the ticked parcels</span></button>
                <p class="hint">The rider sees them on their phone at once, and each recipient gets a text that the parcel is on its way. Parcels that do not fit on the rider's vehicle stay here.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
    (() => {
        const boxes = [...document.querySelectorAll("#assign input[name=codes]")];
        const all = document.querySelector("[data-select-all]");
        const count = document.querySelector("[data-selected]");
        const button = document.querySelector("[data-hand-over]");
        const room = document.querySelector("[data-room]");
        const riders = [...document.querySelectorAll("input[name=riderId]")];
        const kg = grams => `${Math.round(grams / 100) / 10} kg`;
        // Says before the hand-over when the ticked parcels are more than the chosen rider's vehicle has room for
        const checkRoom = () => {
            const rider = riders.find(radio => radio.checked);
            const chosen = boxes.filter(box => box.checked);
            const grams = chosen.reduce((sum, box) => sum + Number(box.dataset.grams || 0), 0);
            // Each rider's load shows what they carry now; the chosen one also counts the ticked parcels
            riders.forEach(radio => {
                const text = radio.closest("label").querySelector("[data-load-text]");
                const meter = radio.closest("label").querySelector("[data-load-meter]");
                if (!text || !radio.dataset.max || !radio.dataset.load) {
                    return;
                }

                const add = radio.checked ? chosen.length : 0;
                const addGrams = radio.checked ? grams : 0;
                const parcelsNow = Number(radio.dataset.with) + add;
                const gramsNow = Number(radio.dataset.carried) + addGrams;
                text.textContent = `${parcelsNow}/${radio.dataset.max} · ${kg(gramsNow)} of ${kg(Number(radio.dataset.load))}`;
                const share = Math.min(100, Math.max(100 * parcelsNow / Number(radio.dataset.max), 100 * gramsNow / Number(radio.dataset.load)));
                meter.firstElementChild.style.width = `${share}%`;
                meter.classList.toggle("full", share >= 100);
                meter.classList.toggle("warn", share >= 80 && share < 100);
            });
            const parcels = rider?.dataset.roomParcels;
            const weight = rider?.dataset.roomGrams;
            const maxParcel = rider?.dataset.maxParcel;
            const heavy = maxParcel ? chosen.filter(box => Number(box.dataset.grams || 0) > Number(maxParcel)) : [];
            const over = parcels !== undefined && (chosen.length > Number(parcels) || grams > Number(weight));
            room.hidden = !over && heavy.length === 0;
            if (heavy.length > 0) {
                room.textContent = `${heavy.length} of the ticked parcels weigh more than ${rider.dataset.name}'s ${rider.dataset.vehicle} takes ` +
                    `(the heaviest single parcel it may carry is ${kg(Number(maxParcel))}, set on Vehicles). Give ${heavy.length === 1 ? "it" : "them"} to a rider on a bigger vehicle.`;
            } else if (over) {
                room.textContent = `${chosen.length} parcels, ${kg(grams)}: ${rider.dataset.name}'s ${rider.dataset.vehicle} has room for ` +
                    `${Math.max(0, Number(parcels))} more parcels and ${kg(Math.max(0, Number(weight)))}. The most urgent go; the rest stay here.`;
            }
        };
        riders.forEach(radio => radio.addEventListener("change", checkRoom));
        const update = () => {
            const ticked = boxes.filter(box => box.checked).length;
            checkRoom();
            count.textContent = ticked;
            count.classList.remove("bump");
            void count.offsetWidth;
            count.classList.add("bump");
            setTimeout(() => count.classList.remove("bump"), 250);
            if (button) {
                button.disabled = ticked === 0;
                button.querySelector("span").textContent = ticked === 0
                    ? "Tick parcels to hand over"
                    : `Hand over ${ticked} parcel${ticked === 1 ? "" : "s"}`;
            }

            if (all) {
                const due = boxes.filter(box => !box.dataset.later);
                all.checked = due.length > 0 && due.every(box => box.checked);
                all.indeterminate = ticked > 0 && !all.checked;
            }
        };
        // Every parcel due today; one the customer asked to have later stays for its day unless ticked by hand
        all?.addEventListener("change", () => {
            boxes.forEach(box => box.checked = all.checked && !box.dataset.later);
            update();
        });
        boxes.forEach(box => box.addEventListener("change", update));
        update();
    })();
    </script>
}
