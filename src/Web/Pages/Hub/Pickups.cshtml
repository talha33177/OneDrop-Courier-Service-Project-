@page
@using Domain.Delivery
@model Web.Pages.Hub.PickupsModel
@inject ITenantContext TenantContext
@{
    ViewData["Title"] = "Today's pickups";
    var tenant = TenantContext.Require();
    var cutoff = tenant.PickupCutoff is { } c ? Statuses.Clock(c) : null;
    var leaves = tenant.PickupTime is { } l ? Statuses.Clock(l) : null;
    var waitingToday = Model.Requests.Where(r => r.Status == PickupStatus.Scheduled && r.Date <= Model.Today).ToList();
}

<div class="page-head">
    <div>
        <h1>Today's pickups</h1>
        <p>
            Every merchant with parcels booked at a pickup point of this hub is on the day's list by itself.
            @if (cutoff is not null)
            {
                <text>The list takes parcels booked before @cutoff@(leaves is null ? "" : $"; the truck leaves at {leaves}"). Parcels booked later go on tomorrow's.</text>
            }
            Give each pickup a rider whose vehicle carries it, or one rider the whole round.
        </p>
    </div>
    <div class="page-actions">@await Html.PartialAsync("_HubSwitch", (Model.Work, Model.Hub))</div>
</div>

<partial name="_Alerts" />

@if (Model.Hub is not null && waitingToday.Count > 0 && Model.Riders.Count > 0)
{
    <form method="post" asp-page-handler="AssignAll" asp-route-hub="@Model.Hub.Code" class="card assign-all">
        <input type="hidden" name="day" value="@Model.Today.ToString("yyyy-MM-dd")" />
        <div class="card-body gap">
            <span class="stat-icon">@Icons.Get("truck")</span>
            <div class="grow">
                <strong>@waitingToday.Count pickup@(waitingToday.Count == 1 ? "" : "s") today without a rider</strong>
                <div class="cell-sub">@(Model.ListClosed ? "Today's list is closed." : $"The list is still open until {cutoff}.") Send the truck on the whole round.</div>
            </div>
            <select name="riderId" style="width:auto" required>
                <option value="">Choose the rider</option>
                @foreach (var rider in Model.Riders.OrderByDescending(r => r.Vehicle))
                {
                    <option value="@rider.Id">@rider.Name · @rider.Vehicle.DisplayName().ToLowerInvariant()</option>
                }
            </select>
            <button class="btn btn-primary" type="submit">Give all to this rider</button>
        </div>
    </form>
}

<div class="card">
    @if (Model.Requests.Count == 0)
    {
        <div class="empty">@Icons.Get("truck")<h3>No pickups to make</h3><p>A merchant's pickup point joins the list as soon as it books a parcel.</p></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>Day</th><th>Merchant</th><th>Pickup point</th><th class="num">Parcels</th><th>Status</th><th>Rider</th></tr></thead>
                <tbody>
                    @foreach (var request in Model.Requests)
                    {
                        var later = request.Date > Model.Today;
                        <tr class="@(later ? "row-faint" : "")">
                            <td class="nowrap"><div class="cell-main">@request.Date.ToString("ddd d MMM")</div><div class="cell-sub">@Statuses.PickupDay(request.Date, Model.Today)@(later ? ", list still open" : "")</div></td>
                            <td><div class="cell-main">@request.Merchant</div><div class="cell-sub">@Money.Phone(request.MerchantPhone)</div></td>
                            <td>
                                <div>@request.Address</div>
                                <div class="cell-sub">@request.Area · @Money.Phone(request.ContactPhone)</div>
                            </td>
                            <td class="num">@(request.Picked ?? request.Parcels)<div class="cell-sub nowrap">@(request.Picked is null ? (request.BookedGrams > 0 ? Money.Kg(request.BookedGrams) : "to collect") : "picked")</div></td>
                            <td>
                                @Statuses.Badge(request.Status)
                                @if (request.Send is { } send)
                                {
                                    <div class="cell-sub"><span class="vehicle" title="The smallest vehicle that carries this pickup">@Icons.Get(Statuses.Icon(send)) Send a @send.DisplayName().ToLowerInvariant()</span></div>
                                }
                            </td>
                            <td>
                                @if (request.Status is PickupStatus.Scheduled or PickupStatus.Assigned)
                                {
                                    <form method="post" asp-page-handler="Assign" asp-route-id="@request.Id" asp-route-hub="@Model.Hub?.Code" class="gap">
                                        <select name="riderId" style="width:auto;height:32px" required>
                                            <option value="">Choose a rider</option>
                                            @foreach (var rider in Model.Riders)
                                            {
                                                <option value="@rider.Id" selected="@(rider.Id == request.RiderId)">@rider.Name · @rider.Vehicle.DisplayName().ToLowerInvariant()</option>
                                            }
                                        </select>
                                        <button class="btn btn-outline btn-sm" type="submit">@(request.RiderId is null ? "Assign" : "Change")</button>
                                    </form>
                                }
                                else
                                {
                                    @(request.Rider ?? "—")
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
