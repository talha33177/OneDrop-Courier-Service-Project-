@page
@model Web.Pages.Hub.IndexModel
@inject ITenantContext TenantContext
@{
    ViewData["Title"] = Model.AllHubs ? "All hubs" : Model.Hub is null ? "Hub board" : $"{Model.Hub.Name} board";
    var b = Model.Board;
    var all = Model.AllHubs;
    var today = TenantContext.Require().Today(DateTime.UtcNow);
    var hubNames = Model.Work.ToDictionary(work => work.Hub.Code, work => work.Hub.Name);

    // A step of one hub opens its page there; on the board of every hub, the chooser for that page. A step of a desk
    // this person does not work shows its count with no link
    string? Go(string page, object? mode = null) => !Model.MayGo(page, mode) ? null : all
        ? Url.Page("/Hub/Choose", new { next = page.Split('/')[^1], mode })!
        : Url.Page(page, new { hub = Model.Hub?.Code, mode })!;
}
@section Head {
    <partial name="_Live" />
}

<div class="page-head">
    <div>
        @if (all)
        {
            <div class="page-kicker">@Icons.Get("warehouse") Every hub · @Model.Work.Count @(Model.Work.Count == 1 ? "hub" : "hubs")</div>
            <h1>All hubs</h1>
            <p>Everything waiting across the courier, in the order the day runs. Choose a hub to work at it. <span class="badge badge-brand" data-live-status>Live</span></p>
        }
        else
        {
            <div class="page-kicker">@Icons.Get("warehouse") @Model.Hub?.Code · @Model.Hub?.Address</div>
            <h1>@(Model.Hub?.Name ?? "Hub board")</h1>
            <p>Everything waiting at this hub, in the order the day runs. <span class="badge badge-brand" data-live-status>Live</span></p>
        }
    </div>
    <div class="page-actions">
        @await Html.PartialAsync("_HubSwitch", Model)
        @if (Model.MayGo("/Hub/Scan", null))
        {
            <a class="btn btn-primary" href="@Go("/Hub/Scan")">@Icons.Get("scan") Scan parcels</a>
        }
    </div>
</div>

@if (b is null)
{
    <div class="card"><div class="empty">@Icons.Get("warehouse")<h3>No hubs yet</h3></div></div>
    return;
}

@{
    var leaves = TenantContext.Require().PickupTime;

    // The hub's day in three phases, so the six steps read as a shape and not as six equal boxes
    (string Phase, string PhaseNote, string Title, int Count, string Hint, bool Late, string Page, string? Mode)[] flow =
    [
        ("Parcels coming in", leaves is { } truck ? $"The van leaves at {Statuses.Clock(truck)}" : "From merchants and other hubs",
            "Pickups to send", b.PickupsOpen, "Give each one a van", false, "/Hub/Pickups", null),
        ("Parcels coming in", "", "Coming in", b.Incoming,
            b.BagsComingIn > 0 ? $"{b.BagsComingIn} bag{(b.BagsComingIn == 1 ? "" : "s")}: scan each bag, then its parcels" : "Scan them in as they arrive", false, "/Hub/Scan", "Receive"),
        ("Sorted here", "What is on the floor now", "Send to other hubs", b.ToDispatchCount,
            b.BagsToSeal > 0 ? $"{b.BagsToSeal} bag{(b.BagsToSeal == 1 ? "" : "s")} to seal onto the truck" : "Bag them per hub", false, "/Hub/Bags", null),
        ("Sorted here", "", "Waiting for a rider", b.ToAssign.Count,
            b.LateToAssign > 0 ? $"{b.LateToAssign} late: hand these out first" : "Hand them to riders", b.LateToAssign > 0, "/Hub/Assign", null),
        ("Parcels going out", "Closed off at the end of the day", "Out with riders", b.WithRiders,
            b.LateRuns > 0
                ? $"{b.LateRuns} rider{(b.LateRuns == 1 ? " is" : "s are")} late back"
                : $"{b.OpenRuns} run{(b.OpenRuns == 1 ? "" : "s")} to close", b.LateRuns > 0, "/Hub/Runs", null),
        ("Parcels going out", "", "Hand back", b.ToHandBackCount, "Send them with a rider, or hand over here", false, "/Hub/Returns", null)
    ];

    // What needs the operator now, most pressing first: only what they may open, and only what is really waiting
    (string Icon, string What, string Why, string Action, string Page, string? Mode, bool Urgent)[] jobs =
    [
        ("clock", $"{b.LateRuns} rider{(b.LateRuns == 1 ? "" : "s")} late back with cash", "Close the run and count what they handed in", "Close runs", "/Hub/Runs", null, true),
        ("alert", $"{b.ShortfallsWaiting} rider shortfall{(b.ShortfallsWaiting == 1 ? "" : "s")} to accept", "A rider handed in less cash than they collected", "Settle it", "/Hub/Cash", null, true),
        ("send", $"{b.LateToAssign} parcel{(b.LateToAssign == 1 ? " is" : "s are")} past the day {(b.LateToAssign == 1 ? "it was" : "they were")} due", "Hand these to a rider before anything else", "Assign first", "/Hub/Assign", null, true),
        ("truck", $"{b.PickupsOpen} pickup{(b.PickupsOpen == 1 ? "" : "s")} with no van", "Merchants are waiting to be collected from", "Give the round to a van", "/Hub/Pickups", null, false),
        ("scan", $"{b.Incoming} parcel{(b.Incoming == 1 ? " is" : "s are")} on the way here", "Scan each one in as it reaches the floor", "Open Receive", "/Hub/Scan", "Receive", false),
        ("send", $"{b.ToAssign.Count} parcel{(b.ToAssign.Count == 1 ? "" : "s")} waiting for a rider", "These are for your own areas", "Assign to riders", "/Hub/Assign", null, false),
        ("bag", $"{b.BagsToSeal} bag{(b.BagsToSeal == 1 ? "" : "s")} to seal", "Seal each one when the truck is loaded, and print its manifest", "Open bags", "/Hub/Bags", null, false),
        ("route", $"{b.ToDispatchCount} parcel{(b.ToDispatchCount == 1 ? "" : "s")} to send to other hubs", "Scan them into the bag for their hub", "Bag them", "/Hub/Scan", "Dispatch", false),
        ("return", $"{b.ToHandBackCount} return{(b.ToHandBackCount == 1 ? "" : "s")} to hand back", "Send them out on a return list, or hand them over here", "Open returns", "/Hub/Returns", null, false),
        ("cash", $"{b.OpenRuns} run{(b.OpenRuns == 1 ? "" : "s")} still open", "Count the cash when the rider is back", "Close runs", "/Hub/Runs", null, false),
        ("bank", $"৳{b.CashAtHub:N0} at the hub to pay into the bank", "Record each deposit with its slip", "Deposit cash", "/Hub/Cash", null, false)
    ];
    var counts = new[]
    {
        b.LateRuns, b.ShortfallsWaiting, b.LateToAssign, b.PickupsOpen, b.Incoming, b.ToAssign.Count, b.BagsToSeal, b.ToDispatchCount,
        b.ToHandBackCount, b.OpenRuns, b.CashAtHub > 0 ? 1 : 0
    };
    var needed = jobs.Where((job, at) => counts[at] > 0 && Go(job.Page, job.Mode) is not null).Take(3).ToList();
}

<div data-live="board">
    <div class="card hub-now">
        <div class="card-head">
            <div>
                <h2>@Icons.Get("bulb") What needs you now</h2>
                <p>@(all ? "Across every hub, most pressing first" : "At this hub, most pressing first")</p>
            </div>
        </div>
        @if (needed.Count == 0)
        {
            <div class="empty">@Icons.Get("check-circle")<h3>Nothing is waiting</h3><p>Every step of the day is clear@(all ? " at every hub" : " here"). Scan a parcel in as soon as it arrives.</p></div>
        }
        else
        {
            <ol class="hub-jobs">
                @foreach (var (job, at) in needed.Select((job, at) => (job, at)))
                {
                    <li class="hub-job @(job.Urgent ? "urgent" : "")">
                        <span class="stat-icon @(job.Urgent ? "red" : "")">@Icons.Get(job.Icon)</span>
                        <div class="hub-job-text">
                            <strong>@job.What</strong>
                            <span>@job.Why</span>
                        </div>
                        <a class="btn @(at == 0 ? "btn-primary" : "btn-outline") btn-sm" href="@Go(job.Page, job.Mode)">@job.Action @Icons.Get("arrow-right")</a>
                    </li>
                }
            </ol>
        }
    </div>

    <div class="hub-phases" aria-label="The hub's day">
        @foreach (var phase in flow.GroupBy(step => step.Phase))
        {
            <section class="hub-phase">
                <header>
                    <span class="hub-phase-label">@phase.Key</span>
                    <span class="hub-phase-note">@phase.Select(step => step.PhaseNote).FirstOrDefault(note => note.Length > 0)</span>
                </header>
                <nav class="flow flow-part" style="--steps:@phase.Count()">
                    @foreach (var step in phase)
                    {
                        <a class="flow-step @(step.Late ? "late" : step.Count > 0 ? "has-work" : "clear")" href="@Go(step.Page, step.Mode)">
                            <span class="flow-title">@step.Title</span>
                            <span class="flow-count">@step.Count</span>
                            <span class="flow-hint">@(step.Count > 0 ? step.Hint : "All clear")</span>
                        </a>
                    }
                </nav>
            </section>
        }
    </div>

    <div class="grid grid-main">
        <div class="card">
            <div class="card-head">
                <div><h2>@Icons.Get("send") Waiting for a rider</h2><p>Parcels @(all ? "each hub delivers" : "this hub delivers"), scanned in and ready to go out</p></div>
                @if (b.ToAssign.Count > 0)
                {
                    <a class="btn btn-primary btn-sm" href="@Go("/Hub/Assign")">Assign to riders @Icons.Get("arrow-right")</a>
                }
            </div>
            @if (b.ToAssign.Count == 0)
            {
                <div class="empty">@Icons.Get("check-circle")<h3>Nothing waiting</h3><p>Parcels for @(all ? "a hub's" : "this hub's") areas show up here once scanned in.</p></div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table compact">
                        <thead><tr><th>Parcel</th>@if (all) { <th>Hub</th> }<th>Area</th><th>Merchant</th><th>Status</th><th class="num">COD</th></tr></thead>
                        <tbody>
                            @foreach (var p in b.ToAssign.Take(15))
                            {
                                var later = p.HoldUntil is { } day && day > today;
                                <tr class="@(later ? "later" : "")">
                                    <td><a class="code-link" asp-page="/Hub/Parcel" asp-route-code="@p.TrackingCode">@p.TrackingCode</a><div class="cell-sub">@p.RecipientName</div></td>
                                    @if (all)
                                    {
                                        <td><a class="code-link" href="@Url.Page("/Hub/Index", new { hub = p.HubCode })">@p.HubCode</a></td>
                                    }
                                    <td>@p.Area</td>
                                    <td>@p.Merchant</td>
                                    <td>
                                        @Statuses.Badge(p.Status) @Statuses.Tags(p.Tags)
                                        @if (p.Issue is { } issue)
                                        {
                                            <div class="mt-xs">@Statuses.Badge(issue)</div>
                                        }
                                        @if (p.HoldUntil is { } until)
                                        {
                                            <div class="@(later ? "row-note" : "cell-sub")">@if (later) { @Icons.Get("calendar") }Customer asked for @until.ToString("ddd d MMM")</div>
                                        }
                                        @if (!later)
                                        {
                                            <div>@Statuses.Due(p.DueOn, p.Status, today)</div>
                                        }
                                    </td>
                                    <td class="num">@Money.Taka(p.CodAmount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (b.ToAssign.Count > 15)
                {
                    <div class="card-foot muted">And @(b.ToAssign.Count - 15) more. <a href="@Go("/Hub/Assign")">See them all</a></div>
                }
            }
        </div>

        <div class="stack">
            <div class="card">
                <div class="card-head"><div><h2>@Icons.Get("route") Send to other hubs</h2><p>@(all ? "What each hub has to send on" : "Scan each one into the bag for its hub, then seal the bags")</p></div></div>
                @if (b.ToDispatch.Count == 0)
                {
                    <div class="card-body muted">Nothing to send on.</div>
                }
                else if (all)
                {
                    <div class="table-wrap">
                        <table class="table compact">
                            <tbody>
                                @foreach (var from in b.ToDispatch.GroupBy(group => group.FromHubCode))
                                {
                                    var to = from.Select(group => group.HubCode).Distinct().Count();
                                    <tr>
                                        <td>
                                            <a class="code-link" href="@Url.Page("/Hub/Index", new { hub = from.Key })">@from.Key</a> @hubNames.GetValueOrDefault(from.Key)
                                            <div class="cell-sub">To @to @(to == 1 ? "hub" : "hubs")@(from.Any(group => group.Returns) ? ", returns among them" : "")</div>
                                        </td>
                                        <td class="num strong">@from.Sum(group => group.Parcels.Count)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table compact">
                            <tbody>
                                @foreach (var group in b.ToDispatch)
                                {
                                    <tr>
                                        <td><span class="code-link">@group.HubCode</span> @group.HubName @if (group.Returns) { <span class="badge badge-return plain">Returns</span> }</td>
                                        <td class="num strong">@group.Parcels.Count</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Go("/Hub/Bags") is { } bags)
                    {
                        <div class="card-foot"><a class="btn btn-outline btn-sm btn-block" href="@bags">@Icons.Get("bag") Open the bags</a></div>
                    }
                }
            </div>
            <div class="card">
                <div class="card-head"><div><h2>@Icons.Get("return") Hand back to merchants</h2><p>@(all ? "Returns each hub collected" : "Returns collected by this hub")</p></div></div>
                @if (b.ToHandBack.Count == 0)
                {
                    <div class="card-body muted">No returns waiting.</div>
                }
                else if (all)
                {
                    <div class="table-wrap">
                        <table class="table compact">
                            <tbody>
                                @foreach (var at in b.ToHandBack.GroupBy(group => group.HubCode))
                                {
                                    <tr>
                                        <td>
                                            <a class="code-link" href="@Url.Page("/Hub/Returns", new { hub = at.Key })">@at.Key</a> @hubNames.GetValueOrDefault(at.Key)
                                            <div class="cell-sub">For @at.Count() @(at.Count() == 1 ? "merchant" : "merchants")</div>
                                        </td>
                                        <td class="num strong">@at.Sum(group => group.Parcels.Count)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table compact">
                            <tbody>
                                @foreach (var group in b.ToHandBack)
                                {
                                    <tr>
                                        <td><div class="cell-main">@group.Merchant</div><div class="cell-sub">@Money.Phone(group.MerchantPhone)</div></td>
                                        <td class="num strong">@group.Parcels.Count</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="stat">
                <div class="stat-icon green">@Icons.Get("cash")</div>
                <div><div class="stat-label">Cash with riders</div><div class="stat-value">@Money.Taka(b.CashWithRiders)</div><div class="stat-sub">Counted when each run is closed</div></div>
            </div>
            <a class="stat" href="@(Go("/Hub/Cash") ?? "#")">
                <div class="stat-icon">@Icons.Get("bank")</div>
                <div><div class="stat-label">Cash at the hub</div><div class="stat-value">@Money.Taka(b.CashAtHub)</div><div class="stat-sub">Handed in, not yet paid into the bank</div></div>
            </a>
        </div>
    </div>
</div>
