@page
@model Web.Pages.Hub.IndexModel
@inject ITenantContext TenantContext
@{
    ViewData["Title"] = Model.Hub is null ? "Hub board" : $"{Model.Hub.Name} board";
    var b = Model.Board;
    var today = TenantContext.Require().Today(DateTime.UtcNow);
}
@section Head {
    <partial name="_Live" />
}

<div class="page-head">
    <div>
        <div class="page-kicker">@Icons.Get("warehouse") @Model.Hub?.Code · @Model.Hub?.Address</div>
        <h1>@(Model.Hub?.Name ?? "Hub board")</h1>
        <p>Everything waiting at this hub, in the order the day runs. <span class="badge badge-brand" data-live-status>Live</span></p>
    </div>
    <div class="page-actions">
        @await Html.PartialAsync("_HubSwitch", (Model.Work, Model.Hub))
        <a class="btn btn-primary" asp-page="/Hub/Scan" asp-route-hub="@Model.Hub?.Code">@Icons.Get("scan") Scan parcels</a>
    </div>
</div>

@if (b is null)
{
    <div class="card"><div class="empty">@Icons.Get("warehouse")<h3>No hubs yet</h3></div></div>
    return;
}

<div class="tip" data-tip="hub-board">
    @Icons.Get("bulb")
    <div>
        <div class="tip-title">How a day at the hub runs</div>
        <p>Work through the steps from left to right. A step with a blue number has work waiting; press it to go there.</p>
    </div>
</div>

<div data-live="board">
    @{
        (string Title, int Count, string Hint, string Page, string? Mode)[] flow =
        [
            ("Pickups to send", b.PickupsOpen, "Give each one a rider", "/Hub/Pickups", null),
            ("Coming in", b.Incoming, "Scan them in as they arrive", "/Hub/Scan", "Receive"),
            ("Send to other hubs", b.ToDispatchCount, "Scan out in Send mode", "/Hub/Scan", "Dispatch"),
            ("Waiting for a rider", b.ToAssign.Count, b.LateToAssign > 0 ? $"{b.LateToAssign} late: hand them out first" : "Hand them to riders", "/Hub/Assign", null),
            ("Out with riders", b.WithRiders, b.LateRuns > 0 ? $"{b.LateRuns} rider{(b.LateRuns == 1 ? " is" : "s are")} late back" : $"{b.OpenRuns} run{(b.OpenRuns == 1 ? "" : "s")} to close", "/Hub/Runs", null),
            ("Hand back", b.ToHandBackCount, "Send them with a rider, or hand over here", "/Hub/Returns", null)
        ];
    }
    <nav class="flow" style="--steps:@flow.Length" aria-label="The hub's day">
        @foreach (var step in flow)
        {
            <a class="flow-step @(step.Count > 0 ? "has-work" : "clear")" href="@Url.Page(step.Page, new { hub = b.Hub.Code, mode = step.Mode })">
                <span class="flow-title">@step.Title</span>
                <span class="flow-count">@step.Count</span>
                <span class="flow-hint">@(step.Count > 0 ? step.Hint : "All clear")</span>
            </a>
        }
    </nav>

    <div class="grid grid-main">
        <div class="card">
            <div class="card-head">
                <div><h2>@Icons.Get("send") Waiting for a rider</h2><p>Parcels this hub delivers, scanned in and ready to go out</p></div>
                @if (b.ToAssign.Count > 0)
                {
                    <a class="btn btn-primary btn-sm" asp-page="/Hub/Assign" asp-route-hub="@b.Hub.Code">Assign to riders @Icons.Get("arrow-right")</a>
                }
            </div>
            @if (b.ToAssign.Count == 0)
            {
                <div class="empty">@Icons.Get("check-circle")<h3>Nothing waiting</h3><p>Parcels for this hub's areas show up here once scanned in.</p></div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table compact">
                        <thead><tr><th>Parcel</th><th>Area</th><th>Merchant</th><th>Status</th><th class="num">COD</th></tr></thead>
                        <tbody>
                            @foreach (var p in b.ToAssign.Take(15))
                            {
                                var later = p.HoldUntil is { } day && day > today;
                                <tr class="@(later ? "later" : "")">
                                    <td><a class="code-link" asp-page="/Hub/Parcel" asp-route-code="@p.TrackingCode">@p.TrackingCode</a><div class="cell-sub">@p.RecipientName</div></td>
                                    <td>@p.Area</td>
                                    <td>@p.Merchant</td>
                                    <td>
                                        @Statuses.Badge(p.Status) @Statuses.Tags(p.Speed, p.ProductType)
                                        @if (p.Issue is { } issue)
                                        {
                                            <div class="mt-xs">@Statuses.Badge(issue)</div>
                                        }
                                        @if (p.HoldUntil is { } until)
                                        {
                                            <div class="@(later ? "row-note" : "cell-sub")">@if (later) { @Icons.Get("calendar") }Customer asked for @until.ToString("ddd d MMM")</div>
                                        }
                                        @if (!later)
                                        {
                                            <div>@Statuses.Due(p.DueOn, p.Status, today)</div>
                                        }
                                    </td>
                                    <td class="num">@Money.Taka(p.CodAmount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (b.ToAssign.Count > 15)
                {
                    <div class="card-foot muted">And @(b.ToAssign.Count - 15) more. <a asp-page="/Hub/Assign" asp-route-hub="@b.Hub.Code">See them all</a></div>
                }
            }
        </div>

        <div class="stack">
            <div class="card">
                <div class="card-head"><div><h2>@Icons.Get("route") Send to other hubs</h2><p>Scan each one in Send mode, then bag it for its hub</p></div></div>
                @if (b.ToDispatch.Count == 0)
                {
                    <div class="card-body muted">Nothing to send on.</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table compact">
                            <tbody>
                                @foreach (var group in b.ToDispatch)
                                {
                                    <tr>
                                        <td><span class="code-link">@group.HubCode</span> @group.HubName @if (group.Returns) { <span class="badge badge-return plain">Returns</span> }</td>
                                        <td class="num strong">@group.Parcels.Count</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-foot"><a class="btn btn-outline btn-sm btn-block" asp-page="/Hub/Scan" asp-route-mode="Dispatch" asp-route-hub="@b.Hub.Code">@Icons.Get("scan") Scan to send</a></div>
                }
            </div>
            <div class="card">
                <div class="card-head"><div><h2>@Icons.Get("return") Hand back to merchants</h2><p>Returns collected by this hub</p></div></div>
                @if (b.ToHandBack.Count == 0)
                {
                    <div class="card-body muted">No returns waiting.</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table compact">
                            <tbody>
                                @foreach (var group in b.ToHandBack)
                                {
                                    <tr>
                                        <td><div class="cell-main">@group.Merchant</div><div class="cell-sub">@Money.Phone(group.MerchantPhone)</div></td>
                                        <td class="num strong">@group.Parcels.Count</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="stat">
                <div class="stat-icon green">@Icons.Get("cash")</div>
                <div><div class="stat-label">Cash with riders</div><div class="stat-value">@Money.Taka(b.CashWithRiders)</div><div class="stat-sub">Counted when each run is closed</div></div>
            </div>
        </div>
    </div>
</div>
