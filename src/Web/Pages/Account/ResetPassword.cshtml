@page
@model Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}

<div class="auth-page">
    <div class="auth-card" style="width:100%;max-width:460px">
        <h1>Choose a new password</h1>
        <p class="sub">For your login at @Model.Where.</p>
        @if (Model.Problem is not null)
        {
            <div class="alert alert-error" role="alert">@Icons.Get("alert")<div>@Model.Problem</div></div>
        }
        <form method="post">
            <input type="hidden" name="user" value="@Model.UserId" />
            <input type="hidden" name="Token" value="@Model.Token" />
            <div class="field">
                <label for="password">New password</label>
                <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8" autofocus data-reveal />
                <span class="hint">At least 8 characters, with a capital letter, a small letter and a number.</span>
            </div>
            <div class="field">
                <label for="confirm">New password again</label>
                <input id="confirm" name="confirm" type="password" autocomplete="new-password" required minlength="8" />
            </div>
            <button class="btn btn-primary btn-block btn-lg" type="submit">Set my new password @Icons.Get("lock")</button>
        </form>
        <hr />
        <p class="muted text-center" style="margin:0">Link expired? <a asp-page="/Account/ForgotPassword">Ask for a new one</a></p>
    </div>
</div>
