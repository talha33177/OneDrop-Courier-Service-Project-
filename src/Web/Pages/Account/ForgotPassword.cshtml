@page
@model Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password";
}

<div class="auth-page">
    <div class="auth-card" style="width:100%;max-width:460px">
        @if (Model.Sent)
        {
            <h1>Check your email</h1>
            <p class="sub">If <strong>@Model.Email</strong> has a login at @Model.Where, a link to choose a new password is on its way. It works once, for one day.</p>
            <p class="muted">Nothing after a few minutes? Look in the spam folder, or ask again.</p>
            <a class="btn btn-primary btn-block btn-lg" asp-page="/Account/Login">Back to sign in</a>
        }
        else if (!Model.OnCourierSite)
        {
            <h1>Forgot your password?</h1>
            <p class="sub">Open your courier's own site and ask there. Platform admins are given a new password by another platform admin.</p>
            <a class="btn btn-outline btn-block" asp-page="/Account/Login">Back to sign in</a>
        }
        else
        {
            <h1>Forgot your password?</h1>
            <p class="sub">Enter the email you sign in with at @Model.Where. We send you a link to choose a new password.</p>
            <form method="post">
                <div class="field">
                    <label for="Email">Email</label>
                    <input id="Email" name="Email" type="email" autocomplete="username" placeholder="you@example.com" maxlength="256" required autofocus value="@Model.Email" />
                </div>
                <button class="btn btn-primary btn-block btn-lg" type="submit">Send me a link @Icons.Get("send")</button>
            </form>
            <hr />
            <p class="muted text-center" style="margin:0">Remembered it? <a asp-page="/Account/Login">Sign in</a></p>
        }
    </div>
</div>
