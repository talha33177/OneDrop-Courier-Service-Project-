@page
@using Domain.Pricing
@model Web.Pages.Admin.RatesModel
@{
    ViewData["Title"] = "Delivery rates";
}

<div class="page-head">
    <div>
        <h1>Delivery rates</h1>
        <p>What merchants pay and how soon parcels are delivered. A change applies to parcels booked from now on; parcels already booked keep their charges and delivery time.</p>
    </div>
</div>

<partial name="_Alerts" />

<div class="grid grid-3">
    @foreach (var rate in Model.Rates)
    {
        <form method="post" class="card">
            <input type="hidden" name="area" value="@rate.ServiceArea" />
            <div class="card-head">
                <div>
                    <h2>@rate.ServiceArea.DisplayName()</h2>
                    <p>@(rate.ServiceArea switch { ServiceArea.InsideCity => "Pickup and delivery in the same city", ServiceArea.Suburb => "To a suburb of the pickup's city", _ => "To another city or district" })</p>
                </div>
            </div>
            <div class="card-body">
                <div class="form-grid">
                    <div class="field"><label>First weight</label><div class="input-group"><input type="number" name="includedKg" value="@((rate.IncludedWeightGrams / 1000m).ToString("0.##"))" min="0.1" max="50" step="0.1" required /><span class="suffix">kg</span></div></div>
                    <div class="field"><label>Charge for it</label><div class="input-group"><span class="prefix">৳</span><input type="number" name="baseCharge" value="@rate.BaseCharge.ToString("0.##")" min="0" step="1" required /></div></div>
                    <div class="field"><label>Each extra kg</label><div class="input-group"><span class="prefix">৳</span><input type="number" name="extraKgCharge" value="@rate.ExtraKgCharge.ToString("0.##")" min="0" step="1" required /></div></div>
                    <div class="field"><label>COD charge</label><div class="input-group"><input type="number" name="codChargePercent" value="@rate.CodChargePercent.ToString("0.##")" min="0" max="10" step="0.1" required /><span class="suffix">%</span></div></div>
                    <div class="field field-full"><label>Extra for a return</label><div class="input-group"><span class="prefix">৳</span><input type="number" name="returnCharge" value="@rate.ReturnCharge.ToString("0.##")" min="0" step="1" required /></div><span class="hint">Added to the delivery charge when a parcel comes back.</span></div>
                    <div class="field field-full"><label>Delivered within</label><div class="input-group"><input type="number" name="deliveryDays" value="@rate.DeliveryDays" min="0" max="@DeliveryRate.MaxDeliveryDays" step="1" /><span class="suffix">days of pickup</span></div><span class="hint">0 for the same day. Each parcel gets a day to be delivered by, and the hub sees which are late. Leave empty to promise no time.</span></div>
                </div>
            </div>
            <div class="card-foot"><button class="btn btn-primary" type="submit">Save</button></div>
        </form>
    }
</div>

<div class="part-head mt-lg">
    <div>
        <h2>Delivery types</h2>
        <p>What express delivery and each kind of contents add to the delivery charge. Leave one empty and merchants cannot choose it for that service area; fresh food and frozen, for example, may not survive a long trip.</p>
    </div>
</div>

<div class="grid grid-3">
    @foreach (var rate in Model.Rates)
    {
        var x = rate.Extras;
        <form method="post" asp-page-handler="Extras" class="card">
            <input type="hidden" name="area" value="@rate.ServiceArea" />
            <div class="card-head"><div><h2>@rate.ServiceArea.DisplayName()</h2><p>Regular: @Statuses.Promise(rate.DeliveryDays).ToLowerInvariant() after pickup</p></div></div>
            <div class="card-body">
                <div class="form-grid">
                    <div class="field"><label>@Icons.Get("zap") Express</label><div class="input-group"><span class="prefix">+৳</span><input type="number" name="expressCharge" value="@x.ExpressCharge?.ToString("0.##")" min="0" step="1" placeholder="Not offered" /></div></div>
                    <div class="field"><label>Express within</label><div class="input-group"><input type="number" name="expressDays" value="@x.ExpressDays" min="0" max="@DeliveryRate.MaxDeliveryDays" step="1" placeholder="@rate.DeliveryDays" /><span class="suffix">days</span></div></div>
                    @foreach (var (product, name, value) in new (ProductType, string, decimal?)[]
                    {
                        (ProductType.Liquid, "liquidCharge", x.LiquidCharge),
                        (ProductType.Fragile, "fragileCharge", x.FragileCharge),
                        (ProductType.FreshFood, "freshFoodCharge", x.FreshFoodCharge),
                        (ProductType.Frozen, "frozenCharge", x.FrozenCharge)
                    })
                    {
                        <div class="field"><label>@Icons.Get(Statuses.Icon(product)) @product.DisplayName()</label><div class="input-group"><span class="prefix">+৳</span><input type="number" name="@name" value="@value?.ToString("0.##")" min="0" step="1" placeholder="Not carried" /></div></div>
                    }
                </div>
                <p class="hint mt">Express parcels and fresh or frozen food go first at the hub and on the rider's run. Empty express time keeps the regular one.</p>
            </div>
            <div class="card-foot"><button class="btn btn-primary" type="submit">Save</button></div>
        </form>
    }
</div>
