@page "{id:long}"
@using Domain.Merchants
@model Web.Pages.Admin.MerchantModel
@{
    var m = Model.Merchant;
    var whole = Model.Account;
    ViewData["Title"] = m.Profile.Name;
}

<div class="page-head">
    <div>
        <div class="breadcrumb"><a asp-page="/Admin/Merchants">Merchants</a> <span>/</span> <span>@m.Profile.Name</span></div>
        <h1>@m.Profile.Name @Statuses.Badge(m.Status)</h1>
        <p>@m.Profile.OwnerName · joined @m.Joined.ToString("d MMM yyyy")@(m.LoginEmail is null ? "" : $" · signs in as {m.LoginEmail}")</p>
        @if (m.Account is { } account)
        {
            <p>@Icons.Get("store") A business of <a asp-page="/Admin/Merchant" asp-route-id="@account.Id">@account.Name</a>'s account. Approving, suspending and the payout account apply to the whole account.</p>
        }
    </div>
    <div class="page-actions">
        <a class="btn btn-outline" asp-page="/Hub/Parcels" asp-route-merchantId="@m.Id">@Icons.Get("package") Parcels</a>
        @if (m.Status == MerchantStatus.Pending)
        {
            <form method="post" asp-page-handler="Approve" asp-route-id="@m.Id" class="inline-form"><button class="btn btn-primary" type="submit">@Icons.Get("check") Approve</button></form>
        }
        @if (m.Status == MerchantStatus.Suspended)
        {
            <form method="post" asp-page-handler="Reactivate" asp-route-id="@m.Id" class="inline-form"><button class="btn btn-primary" type="submit">Reactivate</button></form>
        }
        else
        {
            <form method="post" asp-page-handler="Suspend" asp-route-id="@m.Id" class="inline-form"><button class="btn btn-danger" type="submit" data-confirm="They cannot book parcels until you reactivate them." data-confirm-title="Suspend this merchant?" data-confirm-ok="Suspend">Suspend</button></form>
        }
    </div>
</div>

<partial name="_Alerts" />

<div class="stats">
    <div class="stat"><div class="stat-icon blue">@Icons.Get("package")</div><div><div class="stat-label">Parcels</div><div class="stat-value">@m.Parcels</div></div></div>
    <div class="stat"><div class="stat-icon green">@Icons.Get("check-circle")</div><div><div class="stat-label">Delivered</div><div class="stat-value">@m.Delivered</div></div></div>
    <div class="stat"><div class="stat-icon">@Icons.Get("truck")</div><div><div class="stat-label">On the way</div><div class="stat-value">@m.InProgress</div></div></div>
    <div class="stat"><div class="stat-icon red">@Icons.Get("return")</div><div><div class="stat-label">Returned</div><div class="stat-value">@m.Returned</div><div class="stat-sub">@(m.ReturnRate is { } rate ? $"{Math.Round(rate * 100, MidpointRounding.AwayFromZero)}% return rate" : "No parcel finished yet")</div></div></div>
    <div class="stat"><div class="stat-icon">@Icons.Get("wallet")</div><div><div class="stat-label">Owed now</div><div class="stat-value">@Money.Taka(m.Unpaid)</div></div></div>
</div>

<div class="grid grid-2">
    <div class="card">
        <div class="card-head"><h2>@Icons.Get("store") Profile</h2></div>
        <div class="card-body">
            <form method="post" asp-page-handler="Profile" asp-route-id="@m.Id">
                <div class="form-grid">
                    <div class="field"><label for="name">Business name</label><input type="text" id="name" name="name" value="@m.Profile.Name" required /></div>
                    <div class="field"><label for="owner">Owner</label><input type="text" id="owner" name="owner" value="@m.Profile.OwnerName" required /></div>
                    <div class="field"><label for="phone">Mobile</label><input type="tel" id="phone" name="phone" value="@Money.Phone(m.Profile.Phone)" required /></div>
                    <div class="field"><label for="email">Email</label><input type="email" id="email" name="email" value="@m.Profile.Email" /></div>
                    <div class="field field-full"><label for="address">Address</label><input type="text" id="address" name="address" value="@m.Profile.Address" required /></div>
                </div>
                <button class="btn btn-outline" type="submit">Save profile</button>
            </form>
        </div>
    </div>
    <div class="card">
        <div class="card-head"><h2>@Icons.Get("wallet") Payout account</h2></div>
        <div class="card-body">
            <form method="post" asp-page-handler="Payout" asp-route-id="@m.Id">
                <div class="field">
                    <label for="method">Method</label>
                    <select id="method" name="method">
                        <option value="@PayoutMethod.Bkash" selected="@(m.PayoutMethod == PayoutMethod.Bkash)">bKash</option>
                        <option value="@PayoutMethod.Nagad" selected="@(m.PayoutMethod == PayoutMethod.Nagad)">Nagad</option>
                        <option value="@PayoutMethod.Bank" selected="@(m.PayoutMethod == PayoutMethod.Bank)">Bank</option>
                    </select>
                </div>
                <div class="field"><label for="payoutAccount">Number or account number</label><input type="text" id="payoutAccount" name="payoutAccount" value="@(m.PayoutMethod == PayoutMethod.Bank ? m.PayoutAccount : Money.Phone(m.PayoutAccount))" required /></div>
                <div class="field"><label for="accountName">Account name (and bank, branch)</label><input type="text" id="accountName" name="accountName" value="@m.PayoutAccountName" required /></div>
                <button class="btn btn-outline" type="submit">Save payout account</button>
            </form>
            @if (whole.PayoutAccounts.Count > 0)
            {
                <h3 class="mt mb">Saved by the merchant</h3>
                <dl class="kv">
                    @foreach (var saved in whole.PayoutAccounts)
                    {
                        <dt>@Statuses.PayoutAccount(saved.Method, saved.Number)</dt><dd>@saved.Name @if (saved.InUse) { <span class="badge badge-brand plain">In use</span> }</dd>
                    }
                </dl>
            }
        </div>
    </div>
</div>

<div class="grid grid-2 mt-lg">
    <div class="card">
        <div class="card-head"><div><h2>@Icons.Get("layers") The account</h2><p>@(whole.Businesses.Count == 1 ? "One business; the merchant has added no others." : $"{whole.Businesses.Count} businesses under one login")</p></div></div>
        <div class="table-wrap">
            <table class="table compact">
                <thead><tr><th>Business</th><th>Status</th><th class="num">On the way</th><th class="num">Owed now</th></tr></thead>
                <tbody>
                    @foreach (var b in whole.Businesses)
                    {
                        <tr>
                            <td class="cell-main">
                                @if (b.Id == m.Id) { @b.Name } else { <a asp-page="/Admin/Merchant" asp-route-id="@b.Id">@b.Name</a> }
                                @if (b.IsMain) { <span class="badge badge-brand plain">Main profile</span> }
                            </td>
                            <td>@Statuses.Badge(b.Status)</td>
                            <td class="num">@b.OnTheWay</td>
                            <td class="num @(b.Unpaid < 0 ? "negative" : "")">@Money.Taka(b.Unpaid)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card">
        <div class="card-head"><div><h2>@Icons.Get("users") Moderators</h2><p>People the owner lets work in the account, in every business of it</p></div></div>
        @if (whole.Moderators.Count == 0)
        {
            <div class="card-body"><p class="muted">Only the owner signs in to this account.</p></div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table compact">
                    <thead><tr><th>Person</th><th>May use</th></tr></thead>
                    <tbody>
                        @foreach (var person in whole.Moderators)
                        {
                            <tr>
                                <td class="cell-main">@person.Name<div class="cell-sub">@person.Email</div>@if (person.Stopped) { <span class="badge badge-cancel">Stopped</span> }</td>
                                <td>@string.Join(", ", Web.Pages.Merchant.ModeratorsModel.Choices.Where(c => person.Permissions.HasFlag(c.Permission)).Select(c => c.Label))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card mt-lg" id="money">
    <div class="card-head">
        <div><h2>@Icons.Get("cash") Money</h2><p>Owed now: <strong class="@(m.Unpaid < 0 ? "negative" : "")">@Money.Taka(m.Unpaid)</strong>@(m.Unpaid < 0 ? " (the merchant owes the courier)" : "")</p></div>
        <div class="page-actions">
            @if (m.PayoutHold is null)
            {
                <form method="post" asp-page-handler="PayNow" asp-route-id="@m.Id" class="inline-form"><button class="btn btn-outline btn-sm" type="submit" data-confirm="Everything not yet paid out, today's parcels too, goes to the payout account in one payout now." data-confirm-title="Pay @m.Profile.Name now?" data-confirm-ok="Pay now" data-confirm-tone="calm">@Icons.Get("send") Pay now</button></form>
            }
        </div>
    </div>
    <div class="card-body">
        @if (m.PayoutHold is { } hold)
        {
            <div class="alert alert-warning" role="status">@Icons.Get("pause")<div>Payouts are on hold for the whole account: <strong>@hold.TrimEnd('.').</strong> Its balance keeps counting and is paid once you release it.</div></div>
        }
        <div class="grid grid-2">
            <div>
                <h3 class="mb">Payouts</h3>
                @if (m.PayoutHold is null)
                {
                    <form method="post" asp-page-handler="Hold" asp-route-id="@m.Id">
                        <div class="field"><label for="holdReason">Hold the payouts because</label><input type="text" id="holdReason" name="reason" maxlength="200" placeholder="Checking a claim about damaged parcels" required /></div>
                        <button class="btn btn-outline" type="submit">@Icons.Get("pause") Hold payouts</button>
                    </form>
                }
                else
                {
                    <p class="muted">The merchant sees the reason on its Payments page and cannot ask to be paid now.</p>
                    <form method="post" asp-page-handler="Release" asp-route-id="@m.Id" class="inline-form"><button class="btn btn-primary" type="submit">Release payouts</button></form>
                }
            </div>
            <div>
                <h3 class="mb">Adjust the balance</h3>
                <form method="post" asp-page-handler="Adjust" asp-route-id="@m.Id">
                    <div class="form-grid">
                        <div class="field">
                            <label for="direction">Kind</label>
                            <select id="direction" name="direction">
                                <option value="credit">Credit: the merchant paid us, or is compensated</option>
                                <option value="charge">Charge: the merchant owes us more</option>
                            </select>
                        </div>
                        <div class="field"><label for="amount">Amount (৳)</label><input type="number" id="amount" name="amount" min="1" step="0.01" required /></div>
                        <div class="field field-full"><label for="note">Why (the merchant reads this)</label><input type="text" id="note" name="note" maxlength="200" placeholder="Paid the courier in cash at Mirpur hub" required /></div>
                    </div>
                    <button class="btn btn-outline" type="submit" data-confirm="The line goes on the merchant's statement and into its next payout. It cannot be removed, only balanced by another adjustment." data-confirm-title="Write this adjustment?" data-confirm-ok="Write it" data-confirm-tone="calm">Write adjustment</button>
                </form>
            </div>
        </div>
    </div>
    @if (m.Adjustments.Count > 0)
    {
        <div class="table-wrap">
            <table class="table compact">
                <thead><tr><th>Day</th><th>Why</th><th class="num">Amount</th><th>Paid in</th></tr></thead>
                <tbody>
                    @foreach (var a in m.Adjustments)
                    {
                        <tr>
                            <td class="nowrap">@a.Date.ToString("d MMM yyyy")</td>
                            <td>@a.Note</td>
                            <td class="num strong @(a.Amount < 0 ? "negative" : "")">@Money.Taka(a.Amount)</td>
                            <td>@if (a.Payout is { } number) { <a class="code-link" asp-page="/Admin/Payout" asp-route-number="@number">@number</a> } else { <span class="muted">Next payout</span> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="grid grid-2 mt-lg">
    <div class="card">
        <div class="card-head"><div><h2>@Icons.Get("wallet") Payouts</h2><p>The latest ten</p></div><a class="btn btn-ghost btn-sm" asp-page="/Admin/Payouts">All payouts @Icons.Get("arrow-right")</a></div>
        @if (whole.Payouts.Count == 0)
        {
            <div class="card-body"><p class="muted">Nothing paid out yet.</p></div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table compact">
                    <thead><tr><th>Invoice</th><th>Up to</th><th>Status</th><th class="num">Amount</th></tr></thead>
                    <tbody>
                        @foreach (var payout in whole.Payouts)
                        {
                            <tr>
                                <td><a class="code-link" asp-page="/Admin/Payout" asp-route-number="@payout.Number">@payout.Number</a></td>
                                <td class="nowrap">@payout.UpTo.ToString("d MMM yyyy")</td>
                                <td>@Statuses.Badge(payout.Status, payout.Stuck)</td>
                                <td class="num strong">@Money.Taka(payout.Amount)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="card">
        <div class="card-head"><div><h2>@Icons.Get("message") Requests</h2><p>About its parcels and to be paid now, the latest first</p></div><a class="btn btn-ghost btn-sm" asp-page="/Admin/Requests">Answer requests @Icons.Get("arrow-right")</a></div>
        @if (whole.Requests.Count == 0)
        {
            <div class="card-body"><p class="muted">The merchant has asked for nothing.</p></div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table compact">
                    <thead><tr><th>Asked</th><th>For</th><th>Answer</th></tr></thead>
                    <tbody>
                        @foreach (var request in whole.Requests)
                        {
                            <tr>
                                <td class="nowrap">@request.Asked.ToString("d MMM, h:mm tt")</td>
                                <td>
                                    @request.What @if (request.Amount is { } amount) { @Money.Taka(amount) }
                                    @if (request.TrackingCode is { } code) { <div><a class="code-link" asp-page="/Hub/Parcel" asp-route-code="@code">@code</a></div> }
                                </td>
                                <td><span class="badge badge-@(request.Open ? "pending" : request.Status is "Approved" or "Paid" ? "done" : "cancel")">@(request.Open ? "Waiting for an answer" : request.Status)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card mt-lg">
    <div class="card-head"><h2>@Icons.Get("map-pin") Pickup points</h2></div>
    <div class="table-wrap">
        <table class="table compact">
            <thead><tr><th>Name</th><th>Address</th><th>Area</th><th>Phone</th></tr></thead>
            <tbody>
                @foreach (var point in m.PickupPoints)
                {
                    <tr><td class="cell-main">@point.Name @if (point.IsDefault) { <span class="badge badge-brand plain">Default</span> }</td><td>@point.Address</td><td>@point.Area</td><td>@Money.Phone(point.ContactPhone)</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-head"><h2>Latest parcels</h2><a class="btn btn-ghost btn-sm" asp-page="/Hub/Parcels" asp-route-merchantId="@m.Id">View all @Icons.Get("arrow-right")</a></div>
    @await Html.PartialAsync("_ParcelTable", (Model.Recent, "/Hub/Parcel/", false, false))
</div>
