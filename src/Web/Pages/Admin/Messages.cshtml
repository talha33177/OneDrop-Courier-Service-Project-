@page
@model Web.Pages.Admin.MessagesModel
@{
    ViewData["Title"] = "Failed messages";
}

<div class="page-head">
    <div>
        <h1>Failed messages</h1>
        <p>Texts to recipients, updates to merchants' websites and emails that have not gone out, the latest 100. A failure is tried again after 1, 2, 4 and 8 minutes, then given up.</p>
    </div>
</div>

@if (Model.Done is not null)
{
    <div class="alert alert-success" role="status">@Icons.Get("check-circle")<div>@Model.Done</div></div>
}

<div class="card">
    @if (Model.Messages.Count == 0)
    {
        <div class="empty">@Icons.Get("check-circle")<h3>Nothing has failed</h3><p>Every text, website update and email has gone out.</p></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>When</th><th>What</th><th>About</th><th>To</th><th class="num">Tries</th><th>Last error</th><th></th></tr></thead>
                <tbody>
                    @foreach (var message in Model.Messages)
                    {
                        <tr>
                            <td class="nowrap">@message.Created.ToString("d MMM HH:mm")</td>
                            <td>@(message.Channel switch { Application.Notifications.FailedMessages.MessageChannel.Text => "Text", Application.Notifications.FailedMessages.MessageChannel.Email => "Email", _ => "Website update" })</td>
                            <td>@message.About</td>
                            <td>@message.To</td>
                            <td class="num">@message.Attempts</td>
                            <td class="cell-sub" style="max-width:320px">@message.LastError</td>
                            <td class="text-right">
                                @if (message.GivenUp)
                                {
                                    <span class="badge badge-return">Given up</span>
                                    <form method="post" asp-page-handler="SendAgain" class="inline-form">
                                        <input type="hidden" name="id" value="@message.Id" />
                                        <button type="submit" class="btn btn-outline btn-sm">Send again</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge badge-pending">Retrying</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
