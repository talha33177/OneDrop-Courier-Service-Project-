@page
@using Domain.Delivery
@model Web.Pages.Admin.RidersModel
@{
    ViewData["Title"] = "Riders";
}

<div class="page-head">
    <div>
        <h1>Riders</h1>
        <p>Who picks up and delivers, from which hub, and on what. A rider is never handed more than their vehicle carries, and only a pickup van goes to the merchants.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline" asp-page="/Admin/Vehicles">@Icons.Get("truck") What each vehicle carries</a>
        <form method="get" class="hub-switch">
            @Icons.Get("warehouse")
            <select name="hubId" onchange="this.form.submit()" aria-label="Hub">
                <option value="">All hubs</option>
                @foreach (var hub in Model.Hubs)
                {
                    <option value="@hub.Id" selected="@(hub.Id == Model.HubId)">@hub.Name</option>
                }
            </select>
        </form>
    </div>
</div>

<partial name="_Alerts" />
@if (Model.Problem is not null)
{
    <div class="alert alert-error">@Icons.Get("alert")<div>@Model.Problem</div></div>
}
@{
    // A hub that is staffed but has no van: nobody there can be sent to a merchant. A hub with no riders at all is
    // simply not staffed yet, which its empty list already says
    var vanless = Model.Hubs
        .Where(hub => Model.Rows.Any(r => r.HubId == hub.Id && r.Active) &&
            !Model.Rows.Any(r => r.HubId == hub.Id && r.Active && r.Vehicle == Vehicle.Van))
        .ToList();
}
@if (vanless.Count > 0)
{
    <div class="alert alert-warning">
        @Icons.Get("truck")
        <div>
            <strong>@(vanless.Count == 1 ? $"{vanless[0].Name} has" : $"{vanless.Count} hubs have") no pickup van rider.</strong>
            Only a pickup van goes to a merchant's door, so nobody collects the daily pickups there.
            @if (vanless.Count > 1)
            {
                <text> @string.Join(", ", vanless.Select(h => h.Name)).</text>
            }
        </div>
    </div>
}

<div class="grid grid-side">
    <div class="card">
        @if (Model.Rows.Count == 0)
        {
            <div class="empty">@Icons.Get("bike")<h3>No riders here</h3></div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>Rider</th><th>Hub</th><th>Vehicle</th><th class="num">With them</th><th class="num">Delivered today</th><th class="num">Cash in hand</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr style="@(r.Active ? "" : "opacity:.55")">
                                <td><div class="cell-main"><a asp-page="/Admin/Rider" asp-route-id="@r.Id">@r.Name</a> @if (!r.Active) { <span class="badge badge-cancel">Stopped</span> }</div><div class="cell-sub">@Money.Phone(r.Phone)@(r.Email is null ? "" : $" · {r.Email}")</div></td>
                                <td>@r.Hub</td>
                                <td><span class="vehicle">@Icons.Get(Statuses.Icon(r.Vehicle)) @r.Vehicle.DisplayName()</span></td>
                                <td class="num">@r.WithThem</td>
                                <td class="num">@r.DeliveredToday</td>
                                <td class="num">@Money.Taka(r.CashInHand)</td>
                                <td class="text-right nowrap">
                                    <a class="btn btn-ghost btn-sm" asp-route-edit="@r.Id" asp-route-hubId="@Model.HubId">Edit</a>
                                    <form method="post" asp-page-handler="Active" asp-route-id="@r.Id" asp-route-active="@(!r.Active)" asp-route-hubId="@Model.HubId" class="inline-form">
                                        <button class="btn btn-ghost btn-sm" type="submit" data-confirm="@(r.Active ? $"{r.Name} gets no new parcels or pickups, and their app shows no work until restarted." : $"{r.Name} can sign in and get work again.")" data-confirm-title="@(r.Active ? "Stop this rider?" : "Restart this rider?")" data-confirm-ok="@(r.Active ? "Stop rider" : "Restart")" data-confirm-tone="@(r.Active ? "danger" : "calm")">@(r.Active ? "Stop" : "Restart")</button>
                                    </form>
                                    @if (Model.IsSuperAdmin)
                                    {
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@r.Id" asp-route-hubId="@Model.HubId" class="inline-form">
                                            <button class="btn btn-ghost btn-sm text-danger" type="submit" data-confirm="@($"{r.Name} and their login are erased for good. This only works for a rider who never worked; one with runs on record is stopped instead.")" data-confirm-title="Delete this rider?" data-confirm-ok="Delete rider" data-confirm-tone="danger">Delete</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                            @if (Model.Edit == r.Id)
                            {
                                <tr>
                                    <td colspan="7" style="background:var(--brand-tint)">
                                        <form method="post" asp-page-handler="Edit" asp-route-id="@r.Id" asp-route-hubId="@Model.HubId" class="gap">
                                            <input type="text" name="name" value="@r.Name" required style="max-width:200px" aria-label="Name" />
                                            <input type="tel" name="phone" value="@Money.Phone(r.Phone)" required style="max-width:160px" aria-label="Phone" />
                                            <select name="hubId" style="max-width:200px" aria-label="Hub">
                                                @foreach (var hub in Model.Hubs)
                                                {
                                                    <option value="@hub.Id" selected="@(hub.Id == r.HubId)">@hub.Name</option>
                                                }
                                            </select>
                                            <select name="vehicle" style="max-width:160px" aria-label="Vehicle">
                                                @foreach (var vehicle in Vehicles.All)
                                                {
                                                    <option value="@vehicle" selected="@(vehicle == r.Vehicle)">@vehicle.DisplayName()</option>
                                                }
                                            </select>
                                            <button class="btn btn-primary btn-sm" type="submit">Save</button>
                                            <a class="btn btn-ghost btn-sm" asp-route-hubId="@Model.HubId">Cancel</a>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="card" style="align-self:start">
        <div class="card-head"><h2>@Icons.Get("plus") Add a rider</h2></div>
        <div class="card-body">
            <form method="post" asp-page-handler="Add">
                <div class="field"><label for="name">Name</label><input type="text" id="name" name="name" required /></div>
                <div class="field"><label for="phone">Mobile number</label><input type="tel" id="phone" name="phone" required /></div>
                <div class="field">
                    <label for="hubId">Hub</label>
                    <select id="hubId" name="hubId" required>
                        @foreach (var hub in Model.Hubs)
                        {
                            <option value="@hub.Id" selected="@(hub.Id == Model.HubId)">@hub.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="vehicle">Rides</label>
                    <select id="vehicle" name="vehicle" required>
                        <option value="">Choose</option>
                        @foreach (var vehicle in Vehicles.All)
                        {
                            <option value="@vehicle">@vehicle.DisplayName()</option>
                        }
                    </select>
                    <span class="hint">Decides how many parcels the hub can hand them at once. Only a pickup van collects from merchants; a bicycle or motorbike delivers to recipients.</span>
                </div>
                <div class="field"><label for="email">Email to sign in with</label><input type="email" id="email" name="email" required /></div>
                <div class="field"><label for="password">First password</label><input type="text" id="password" name="password" autocomplete="off" required /></div>
                <button class="btn btn-primary btn-block" type="submit">Add rider</button>
            </form>
        </div>
    </div>
</div>
