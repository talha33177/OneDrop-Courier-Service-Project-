@page
@using Domain.Pricing
@model Web.Pages.Merchant.PricingModel
@{
    ViewData["Title"] = "Rates and calculator";
}

<div class="page-head">
    <div>
        <h1>Rates and calculator</h1>
        <p>What a parcel costs depends on where it goes and how much it weighs.</p>
    </div>
</div>

<div class="card">
    <div class="card-head"><h2>@Icons.Get("tag") Our rates</h2></div>
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Service</th><th class="num">First weight</th><th class="num">Charge</th><th class="num">Each extra kg</th><th class="num">COD charge</th><th class="num">Extra for a return</th><th>Delivery after pickup</th></tr></thead>
            <tbody>
                @foreach (var rate in Model.Rates)
                {
                    <tr>
                        <td class="cell-main">@rate.ServiceArea.DisplayName()</td>
                        <td class="num">@Money.Kg(rate.IncludedWeightGrams)</td>
                        <td class="num">@Money.Taka(rate.BaseCharge)</td>
                        <td class="num">@Money.Taka(rate.ExtraKgCharge)</td>
                        <td class="num">@rate.CodChargePercent.ToString("0.##")%</td>
                        <td class="num">@Money.Taka(rate.ReturnCharge)</td>
                        <td>@Statuses.Promise(rate.DeliveryDays)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-foot muted">Inside city: picked up and delivered in the same city. Suburb: to a suburb of that city. Outside city: to any other city or district.</div>
</div>

<div class="card">
    <div class="card-head"><div><h2>@Icons.Get("zap") Delivery types</h2><p>Added to the delivery charge when you choose them while booking</p></div></div>
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Type</th>
                    @foreach (var rate in Model.Rates)
                    {
                        <th class="num">@rate.ServiceArea.DisplayName()</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var option in Model.DeliveryTypes.Where(o => !o.IsDefault))
                {
                    <tr>
                        <td><div class="cell-main">@Icons.Named(option.Icon) @option.Name</div><div class="cell-sub">@option.Description</div></td>
                        @foreach (var rate in Model.Rates)
                        {
                            <td class="num">
                                @if (option.ChargeIn(rate.ServiceArea) is { } extra)
                                {
                                    <span>+@Money.Taka(extra)</span>
                                    @if (option.Kind == DeliveryOptionKind.Speed)
                                    {
                                        <div class="cell-sub">@Statuses.Promise(option.DaysIn(rate.ServiceArea) ?? rate.DeliveryDays).ToLowerInvariant()</div>
                                    }
                                }
                                else
                                {
                                    <span class="faint">Not offered</span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-head"><h2>@Icons.Get("chart") Price calculator</h2></div>
    <div class="card-body">
        <form id="calc" class="form-grid-3" onsubmit="return false">
            @if (Model.Points.Count > 1)
            {
                <div class="field">
                    <label for="pickupPointId">From</label>
                    <select id="pickupPointId" name="pickupPointId">
                        @foreach (var point in Model.Points)
                        {
                            <option value="@point.Id" selected="@point.IsDefault">@point.Name, @point.Area</option>
                        }
                    </select>
                </div>
            }
            <div class="field">
                <label for="areaId">To</label>
                @await Html.PartialAsync("_AreaSelect", ("areaId", (long?)null, Model.Areas))
            </div>
            <div class="field">
                <label for="weightKg">Weight (kg)</label>
                <input type="number" id="weightKg" name="weightKg" value="0.5" min="0.01" max="30" step="0.01" />
            </div>
            <div class="field">
                <label for="codAmount">Cash to collect (৳)</label>
                <input type="number" id="codAmount" name="codAmount" value="1000" min="0" step="1" />
            </div>
            <div class="field">
                <label for="speed">Speed</label>
                <select id="speed" name="speed">
                    @foreach (var speed in Model.DeliveryTypes.Where(o => o.Kind == DeliveryOptionKind.Speed))
                    {
                        <option value="@speed.Code" selected="@speed.IsDefault">@speed.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="productType">What is inside</label>
                <select id="productType" name="productType">
                    @foreach (var product in Model.DeliveryTypes.Where(o => o.Kind == DeliveryOptionKind.Contents))
                    {
                        <option value="@product.Code" selected="@product.IsDefault">@product.Name</option>
                    }
                </select>
            </div>
        </form>
        <div class="alert alert-warning mt" id="calc-problem" hidden></div>
        <div class="stats" id="result" hidden>
            <div class="stat"><div><div class="stat-label">Service</div><div class="stat-value" data-r="service" style="font-size:18px"></div></div></div>
            <div class="stat"><div><div class="stat-label">Delivery charge</div><div class="stat-value" data-r="delivery"></div></div></div>
            <div class="stat"><div><div class="stat-label">COD charge</div><div class="stat-value" data-r="cod"></div></div></div>
            <div class="stat"><div><div class="stat-label">You pay</div><div class="stat-value" data-r="total"></div></div></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById("calc");
            const result = document.getElementById("result");
            const taka = n => "৳" + Math.round(n).toLocaleString("en-US");
            const run = async () => {
                const data = new FormData(form);
                if (!data.get("areaId")) {
                    return;
                }

                data.append("handler", "Quote");
                const response = await fetch("@Url.Page("/Merchant/NewParcel")?" + new URLSearchParams(data), { credentials: "same-origin" });
                if (!response.ok) {
                    return;
                }

                const q = await response.json();
                result.querySelector("[data-r=service]").textContent = q.service;
                result.querySelector("[data-r=delivery]").textContent = taka(q.deliveryCharge);
                result.querySelector("[data-r=cod]").textContent = taka(q.codCharge);
                result.querySelector("[data-r=total]").textContent = taka(q.total);
                result.hidden = false;
                const problem = document.getElementById("calc-problem");
                problem.textContent = q.problem ? q.problem + " The charges shown are for the courier's usual delivery." : "";
                problem.hidden = !q.problem;
            };
            form.addEventListener("input", run);
        })();
    </script>
}
