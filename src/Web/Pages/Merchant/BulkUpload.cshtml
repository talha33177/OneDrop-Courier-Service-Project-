@page
@using Application.Parcels.BulkImport
@model Web.Pages.Merchant.BulkUploadModel
@{
    ViewData["Title"] = "Bulk upload";
}

<div class="page-head">
    <div>
        <div class="breadcrumb"><a asp-page="/Merchant/Parcels">Parcels</a> <span>/</span> <span>Bulk upload</span></div>
        <h1>Bulk upload</h1>
        <p>Book up to @BulkImportHandler.MaxRows parcels at once from an Excel workbook or a CSV file.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline" asp-page-handler="CsvTemplate">@Icons.Get("download") CSV template</a>
        <a class="btn btn-primary" asp-page-handler="Template">@Icons.Get("download") Download the Excel template</a>
    </div>
</div>

@if (Model.Problem is not null)
{
    <div class="alert alert-error">@Icons.Get("alert")<div>@Model.Problem</div></div>
}

@if (Model.Result is { } result)
{
    if (result.Problems.Count > 0)
    {
        <div class="card mb">
            <div class="card-head">
                <div><h2>@Icons.Get("alert") Fix these rows and upload again</h2><p>Nothing was booked: a file is booked only when every row is good.</p></div>
            </div>
            <div class="table-wrap">
                <table class="table compact">
                    <thead><tr><th>Line</th><th>Problem</th></tr></thead>
                    <tbody>
                        @foreach (var problem in result.Problems)
                        {
                            <tr><td class="nowrap">Line @problem.Line</td><td>@problem.Message</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success">@Icons.Get("check-circle")<div><strong>@result.Booked.Count parcels booked.</strong> Charges come to @Money.Taka(result.Booked.Sum(p => p.TotalCharge)) if all are delivered.</div></div>
        <div class="card mb">
            <div class="card-head">
                <h2>Booked parcels</h2>
                <a class="btn btn-outline btn-sm" href="@Url.Page("/Merchant/Labels", new { codes = result.Booked.Select(p => p.TrackingCode).ToArray() })">@Icons.Get("printer") Print their labels</a>
            </div>
            <div class="table-wrap">
                <table class="table compact">
                    <thead><tr><th>Tracking code</th><th>Invoice</th><th>Area</th><th class="num">COD</th><th class="num">Charge</th></tr></thead>
                    <tbody>
                        @foreach (var parcel in result.Booked)
                        {
                            <tr>
                                <td><a class="code-link" asp-page="/Merchant/Parcel" asp-route-code="@parcel.TrackingCode">@parcel.TrackingCode</a></td>
                                <td>@(parcel.MerchantReference ?? "—")</td>
                                <td>@parcel.Area</td>
                                <td class="num">@Money.Taka(parcel.CodAmount)</td>
                                <td class="num">@Money.Taka(parcel.TotalCharge)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<div class="card mb">
    <div class="card-head"><h2>@Icons.Get("info") How it works</h2></div>
    <ol class="guide-steps">
        <li>
            <div class="guide-step-text">
                <h3>Download the template</h3>
                <p>An empty Excel sheet with a column for each detail. Area, speed and what is inside are drop-down lists.</p>
            </div>
        </li>
        <li>
            <div class="guide-step-text">
                <h3>Fill in one parcel per row</h3>
                <p>Open the Parcels sheet and start on row 2. Columns marked * are required; the others can stay empty.</p>
            </div>
        </li>
        <li>
            <div class="guide-step-text">
                <h3>Upload it here</h3>
                <p>Every row is checked first. Nothing is booked until all rows are right, and any row to fix is listed with its number.</p>
            </div>
        </li>
    </ol>
</div>

<div class="grid grid-main">
    <div class="card">
        <div class="card-head"><h2>@Icons.Get("upload") Upload a file</h2></div>
        <div class="card-body">
            <form method="post" enctype="multipart/form-data">
                <div class="field">
                    <label for="file">Filled-in template</label>
                    <input type="file" id="file" name="file" accept=".xlsx,.csv,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
                    <span class="hint">The Excel template (.xlsx), or a spreadsheet saved as "CSV UTF-8". At most 1 MB.</span>
                </div>
                <button class="btn btn-primary" type="submit">@Icons.Get("upload") Check and book</button>
            </form>
        </div>
    </div>
    <div class="card">
        <div class="card-head"><h2>@Icons.Get("info") Good to know</h2></div>
        <div class="card-body">
            <p class="hint mt-0">Every parcel goes with the day's pickup by itself: booked before the truck reaches your pickup point, it is collected the same day; once the truck has been, with the next day's.</p>
            <details class="mt">
                <summary class="link-btn">Show the @Model.Template.Areas.Count area names</summary>
                <div class="pill-row mt">
                    @foreach (var area in Model.Template.Areas)
                    {
                        <span class="pill">@area.Name</span>
                    }
                </div>
            </details>
        </div>
    </div>
</div>

<div class="card mt">
    <div class="card-head"><h2>@Icons.Get("info") What goes in each column</h2></div>
    <div class="table-wrap">
        <table class="table compact">
            <thead><tr><th>Column</th><th>Needed</th><th>What to write</th></tr></thead>
            <tbody>
                @foreach (var column in Model.Template.Columns)
                {
                    <tr>
                        <td><strong>@column.Title</strong><div class="hint mt-xs"><code>@column.Key</code></div></td>
                        <td>@if (column.Required) { <span class="badge badge-brand plain">Required</span> } else { <span class="badge badge-cancel plain">Optional</span> }</td>
                        <td>@column.Help</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
