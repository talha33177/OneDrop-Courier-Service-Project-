@page
@using Domain.Delivery
@model Web.Pages.Merchant.PickupsModel
@{
    ViewData["Title"] = "Pickups";
    var d = Model.Data;
    var cutoff = d.Cutoff is { } c ? Statuses.Clock(c) : null;
    var leaves = d.LeavesAt is { } l ? Statuses.Clock(l) : null;
    var today = d.Points.Sum(p => p.Today);
    var later = d.Points.Sum(p => p.Later);
}

<div class="page-head">
    <div>
        <h1>Pickups</h1>
        <p>We collect from you once a day. You do not need to ask: every parcel you book goes with a pickup by itself.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-page="/Merchant/NewParcel">@Icons.Get("plus") Book a parcel</a>
    </div>
</div>

<partial name="_Alerts" />

<div class="pickup-rule card">
    <div class="card-body">
        <div class="pickup-rule-steps">
            <div>
                <span class="stat-icon">@Icons.Get("package")</span>
                <div><strong>Book@(cutoff is null ? "" : $" before {cutoff}")</strong><small>Pack and label the parcel@(cutoff is null ? "" : "; booked later, it goes the next day")</small></div>
            </div>
            <div>
                <span class="stat-icon">@Icons.Get("truck")</span>
                <div><strong>@(leaves is null ? "Our pickup comes" : $"The truck leaves at {leaves}")</strong><small>It collects from every pickup point on its round</small></div>
            </div>
            <div>
                <span class="stat-icon">@Icons.Get("warehouse")</span>
                <div><strong>At the hub the same evening</strong><small>Sorted and sent on for delivery</small></div>
            </div>
        </div>
        <p class="next-pickup @(d.TodayClosed ? "closed" : "")">
            @Icons.Get("clock")
            @if (d.TodayClosed)
            {
                <span>Today's pickup list closed at @cutoff. A parcel booked now goes <strong>@Statuses.PickupDay(d.NextPickup, Model.Today)</strong>.</span>
            }
            else if (cutoff is not null)
            {
                <span>Book before <strong>@cutoff today</strong> and the parcel is collected today@(leaves is null ? "" : $", when the truck leaves the hub at {leaves}").</span>
            }
            else
            {
                <span>Every parcel booked today is collected today.</span>
            }
        </p>
    </div>
</div>

<div class="grid grid-side">
    <div class="card">
        <div class="card-head">
            <div><h2>Your pickups</h2><p>The latest 30, newest first</p></div>
        </div>
        @if (d.Pickups.Count == 0)
        {
            <div class="empty">@Icons.Get("truck")<h3>No pickups yet</h3><p>Book a parcel and it goes with the next pickup.</p><a class="btn btn-primary" asp-page="/Merchant/NewParcel">Book a parcel</a></div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>Day</th><th>Pickup point</th><th class="num">Parcels</th><th>Rider</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var pickup in d.Pickups)
                        {
                            <tr>
                                <td class="nowrap"><div class="cell-main">@pickup.Date.ToString("ddd d MMM")</div>@if (pickup.Date == Model.Today) {<div class="cell-sub">today</div>}</td>
                                <td><div>@pickup.PickupPoint</div><div class="cell-sub">@pickup.Area</div></td>
                                <td class="num">@(pickup.Picked ?? pickup.Parcels)<div class="cell-sub">@(pickup.Picked is null ? pickup.Status is PickupStatus.Scheduled or PickupStatus.Assigned ? "to collect" : "" : "picked")</div></td>
                                <td>
                                    @if (pickup.Rider is not null)
                                    {
                                        <div>@pickup.Rider</div><div class="cell-sub">@Money.Phone(pickup.RiderPhone)</div>
                                    }
                                    else
                                    {
                                        <span class="faint">Not yet</span>
                                    }
                                </td>
                                <td>@Statuses.Badge(pickup.Status)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="card">
        <div class="card-head"><h2>@Icons.Get("map-pin") Waiting at your points</h2></div>
        <div class="card-body">
            @if (d.Points.Count == 0)
            {
                <p class="muted">Add a pickup point in <a asp-page="/Merchant/Settings">Settings</a> first.</p>
            }
            else
            {
                <div class="money-list">
                    @foreach (var point in d.Points)
                    {
                        <div>
                            <span><span class="cell-main">@point.Name</span><span class="cell-sub">@point.Area</span></span>
                            <span class="text-right">
                                <strong>@point.Today</strong> today
                                @if (point.Later > 0)
                                {
                                    <span class="cell-sub">@point.Later @(d.TodayClosed ? "with the next pickup" : "booked after the cut-off")</span>
                                }
                            </span>
                        </div>
                    }
                </div>
                <p class="hint mt">@today parcel@(today == 1 ? "" : "s") go@(today == 1 ? "es" : "") with today's pickup@(later > 0 ? $", {later} with the next" : "").</p>
                <p class="hint">Bringing parcels to a hub yourself? Hub staff scan them in at the counter, any day.</p>
            }
        </div>
    </div>
</div>
