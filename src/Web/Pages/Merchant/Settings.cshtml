@page
@using Domain.Merchants
@model Web.Pages.Merchant.SettingsModel
@{
    ViewData["Title"] = "Settings";
    var a = Model.Account;
    var pa = Model.PayoutAccounts;
}

<div class="page-head">
    <div>
        <h1>Settings</h1>
        <p>Your business, where we pay you, and where we pick up your parcels.</p>
    </div>
    <div class="page-actions">
        <div class="merchant-id" title="Give this number when you call the hotline">
            <span>Merchant ID <strong class="mono">@Model.MerchantId</strong></span>
            <button type="button" class="btn btn-ghost btn-sm" data-copy="@Model.MerchantId" title="Copy the merchant ID" aria-label="Copy the merchant ID">@Icons.Get("copy")</button>
        </div>
        @Statuses.Badge(a.Status)
    </div>
</div>

<partial name="_Alerts" />

<div class="grid grid-2">
    <div class="card">
        <div class="card-head"><h2>@Icons.Get("store") Business profile</h2></div>
        <div class="card-body">
            <div class="picture-edit">
                <span class="avatar picture-edit-image">
                    @if (Model.PictureUrl is { } pictureUrl)
                    {
                        <img src="@pictureUrl" alt="Picture of @a.Profile.Name" />
                    }
                    else
                    {
                        @Icons.Get("store")
                    }
                </span>
                <div class="picture-edit-actions">
                    <form method="post" asp-page-handler="Picture" enctype="multipart/form-data">
                        <label for="picture">Picture of @a.Profile.Name</label>
                        <input type="file" id="picture" name="picture" accept="image/png,image/jpeg,image/webp" required />
                        <span class="hint">Your logo or photo. PNG, JPEG or WebP, up to 512 KB. It shows beside the business name.</span>
                        <button class="btn btn-outline btn-sm" type="submit">@Icons.Get("upload") @(Model.PictureUrl is null ? "Upload picture" : "Change picture")</button>
                    </form>
                    @if (Model.PictureUrl is not null)
                    {
                        <form method="post" asp-page-handler="RemovePicture" class="inline-form">
                            <button class="btn btn-ghost btn-sm" type="submit" data-confirm="The business shows its initial icon again." data-confirm-title="Remove this picture?" data-confirm-ok="Remove">Remove picture</button>
                        </form>
                    }
                </div>
            </div>
            <form method="post" asp-page-handler="Profile">
                <div class="field"><label for="name">Business name</label><input type="text" id="name" name="name" value="@a.Profile.Name" required /></div>
                <div class="field"><label for="owner">Owner's name</label><input type="text" id="owner" name="owner" value="@a.Profile.OwnerName" required /></div>
                <div class="form-grid">
                    <div class="field"><label for="phone">Mobile number</label><input type="tel" id="phone" name="phone" value="@Money.Phone(a.Profile.Phone)" required /></div>
                    <div class="field"><label for="email">Email</label><input type="email" id="email" name="email" value="@a.Profile.Email" /></div>
                </div>
                <div class="field"><label for="address">Business address</label><input type="text" id="address" name="address" value="@a.Profile.Address" required /></div>
                <button class="btn btn-primary" type="submit">Save profile</button>
            </form>
        </div>
    </div>

    <div class="card" id="payout">
        <div class="card-head">
            <div>
                <h2>@Icons.Get("wallet") Payout accounts</h2>
                <p>@(pa.Method is { } now ? $"Payouts go to {Statuses.PayoutAccount(now, pa.Number)}" : "No payout account yet: add one so we can pay you")</p>
            </div>
        </div>
        @if (pa.Saved.Count > 0)
        {
            <div class="table-wrap">
                <table class="table compact">
                    <tbody>
                        @foreach (var saved in pa.Saved)
                        {
                            <tr>
                                <td><strong>@Statuses.PayoutAccount(saved.Method, saved.Number)</strong><div class="cell-sub">@saved.Name</div></td>
                                <td class="text-right nowrap">
                                    @if (saved.InUse)
                                    {
                                        <span class="badge badge-done">Payouts go here</span>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="UsePayout" asp-route-id="@saved.Id" class="inline-form">
                                            <button class="btn btn-outline btn-sm" type="submit">Use for payouts</button>
                                        </form>
                                        <form method="post" asp-page-handler="RemovePayout" asp-route-id="@saved.Id" class="inline-form">
                                            <button class="btn btn-ghost btn-sm" type="submit" data-confirm="The account is no longer kept. Payouts that went there stay on your invoices." data-confirm-title="Remove this account?" data-confirm-ok="Remove">@Icons.Get("x") Remove</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="card-body">
            <form method="post" asp-page-handler="Payout">
                <div class="field">
                    <label>Add an account</label>
                    <div class="radio-cards">
                        <label class="radio-card"><input type="radio" name="method" value="@PayoutMethod.Bkash" checked /> bKash<small>Personal or merchant number</small></label>
                        <label class="radio-card"><input type="radio" name="method" value="@PayoutMethod.Nagad" /> Nagad<small>Personal or merchant number</small></label>
                        <label class="radio-card"><input type="radio" name="method" value="@PayoutMethod.Bank" /> Bank<small>Transfer to an account</small></label>
                    </div>
                </div>
                <div class="field">
                    <label for="payoutAccount">Number or account number</label>
                    <input type="text" id="payoutAccount" name="payoutAccount" required />
                </div>
                <div class="field">
                    <label for="accountName">Account name</label>
                    <input type="text" id="accountName" name="accountName" required />
                    <span class="hint">For a bank, also write the bank and branch.</span>
                </div>
                <label class="check mb"><input type="checkbox" name="use" value="true" checked /> Send my payouts to this account<input type="hidden" name="use" value="false" /></label>
                <button class="btn btn-primary" type="submit">Save the account</button>
            </form>
        </div>
    </div>
</div>

<div class="card mt-lg">
    <div class="card-head"><div><h2>@Icons.Get("map-pin") Pickup points</h2><p>Where riders collect your parcels. New parcels go from the default point unless you choose another. Pin a point on the map and the pickup van is guided to your door, and your stop sits on the rider's route.</p></div></div>
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Name</th><th>Address</th><th>Area</th><th>Phone</th><th>On the map</th><th></th></tr></thead>
            <tbody>
                @foreach (var point in a.PickupPoints)
                {
                    <tr>
                        <td class="cell-main">@point.Name @if (point.IsDefault) { <span class="badge badge-brand plain">Default</span> }</td>
                        <td>@point.Address</td>
                        <td>@point.Area</td>
                        <td>@Money.Phone(point.ContactPhone)</td>
                        <td>
                            @if (point.Pin is { } pin)
                            {
                                <a class="link-btn" href="@MapLinks.Directions(pin)" target="_blank" rel="noopener">@Icons.Get("map-pin") Pinned</a>
                            }
                            else
                            {
                                <span class="faint">By address</span>
                            }
                        </td>
                        <td class="text-right nowrap">
                            <a class="btn btn-ghost btn-sm" asp-page="/Merchant/PickupPoint" asp-route-id="@point.Id">Edit</a>
                            @if (!point.IsDefault)
                            {
                                <form method="post" asp-page-handler="Default" asp-route-id="@point.Id" class="inline-form">
                                    <button class="btn btn-ghost btn-sm" type="submit">Make default</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-body" style="border-top:1px solid var(--line)">
        <a class="btn btn-outline" asp-page="/Merchant/PickupPoint">@Icons.Get("plus") Add a pickup point</a>
    </div>
</div>
