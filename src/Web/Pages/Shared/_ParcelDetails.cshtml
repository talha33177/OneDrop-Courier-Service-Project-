@using Application.Parcels.Browse
@using Domain.Pricing
@model ParcelView
@inject MapsOptions Maps
@inject ITenantContext TenantContext
@* Everything about one parcel: progress, recipient, route, money, history and delivery attempts *@
<div class="grid grid-main">
    <div class="stack">
        <div class="card">
            <div class="card-head">
                <div>
                    <h2>@Statuses.Badge(Model.Status) @Statuses.Tags(Model.Tags) @if (Model.Location is not null) { <span class="muted" style="font-weight:500;font-size:13px">@Model.Location</span> }</h2>
                </div>
                @{ var attemptNumber = Model.Attempts + (Model.Status == ParcelStatus.OutForDelivery ? 1 : 0); }
                @if (attemptNumber > 0)
                {
                    <span class="muted">Attempt @attemptNumber of @Model.MaxAttempts</span>
                }
            </div>
            <div class="card-body">
                <partial name="_ParcelProgress" model="Model.Status" />
                @if (Model.Late)
                {
                    <div class="alert alert-error mt">@Icons.Get("clock")<div><strong>Late:</strong> it should have been delivered by @Model.DueOn!.Value.ToString("dddd d MMM").</div></div>
                }
                else if (Model.DueOn is { } due && ParcelStatuses.ToDeliver.Contains(Model.Status))
                {
                    <p class="hint mt">@Icons.Get("clock") To be delivered by <strong>@due.ToString("dddd d MMM")</strong>@(Model.HoldUntil is null ? "" : ", the day the customer asked for").</p>
                }
                else if (Model.Status == ParcelStatus.Pending && Model.DeliveryDays is { } days)
                {
                    <p class="hint mt">@Icons.Get("clock") Delivered @Statuses.AfterPickup(days).</p>
                }
                @if (Model.PickupOn is { } pickupOn)
                {
                    var tenant = TenantContext.Require();
                    <p class="hint">@Icons.Get("truck") Collected @Statuses.PickupWith(pickupOn, tenant.Today(DateTime.UtcNow), tenant.PickupTime).</p>
                }
                @if (Model.Tags.Handling is { } handling && ParcelStatuses.InProgress.Contains(Model.Status))
                {
                    <p class="handling mt">@Icons.Named(Model.Tags.ContentsIcon) @handling</p>
                }
                @if (Model.HoldReason is not null && Model.Status == ParcelStatus.OnHold)
                {
                    <div class="alert alert-warning mt">@Icons.Get("pause")<div><strong>On hold:</strong> @Model.HoldReason@(Model.HoldUntil is { } until ? $" · deliver on {until:ddd d MMM}" : "")</div></div>
                }
                @if (Model.ReturnReason is not null && Model.Status is ParcelStatus.Returning or ParcelStatus.Returned)
                {
                    <div class="alert alert-error mt">@Icons.Get("return")<div><strong>Return:</strong> @Model.ReturnReason</div></div>
                }
                @if (Model.Issue is { } issue)
                {
                    <div class="alert @(issue == ParcelIssue.InReview ? "alert-warning" : "alert-error") mt">
                        @Icons.Get("flag")
                        <div>
                            <strong>@issue.DisplayName():</strong> @Model.IssueNote
                            <div class="cell-sub">Flagged by the courier on @Model.IssueRaisedOn?.ToString("d MMM, h:mm tt"). It does not go out for delivery until the courier clears it.</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="grid grid-2">
            <div class="card">
                <div class="card-head"><h3>@Icons.Get("user") Recipient</h3></div>
                <div class="card-body">
                    <dl class="kv">
                        <dt>Name</dt><dd>@Model.RecipientName</dd>
                        <dt>Phone</dt><dd><a href="tel:@Money.Phone(Model.RecipientPhone)">@Money.Phone(Model.RecipientPhone)</a></dd>
                        <dt>Address</dt><dd>@Model.RecipientAddress</dd>
                        <dt>Area</dt><dd>@Model.Area, @Model.City</dd>
                        <dt>On the map</dt>
                        <dd>
                            @if (Model.Pin is { } pin)
                            {
                                <a href="@MapLinks.Show(pin)" target="_blank" rel="noopener">@Icons.Get("map-pin") Pinned</a> <span class="cell-sub mono">@pin.Text</span>
                            }
                            else
                            {
                                <span class="faint">Not pinned</span>
                            }
                        </dd>
                        @if (Model.Note is not null)
                        {
                            <dt>Note</dt><dd>@Model.Note</dd>
                        }
                    </dl>
                    @if (Model.Pin is { } door && Maps.Configured)
                    {
                        <iframe class="map-embed mt" title="The door on the map" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="@MapLinks.Embed(Maps.ApiKey!, door)"></iframe>
                    }
                </div>
            </div>
            <div class="card">
                <div class="card-head"><h3>@Icons.Get("route") Route</h3></div>
                <div class="card-body">
                    <dl class="kv">
                        <dt>Merchant</dt><dd>@Model.Merchant</dd>
                        <dt>Pickup</dt><dd>@Model.PickupPoint, @Model.PickupAddress</dd>
                        <dt>Collected by</dt><dd>@Model.PickupHub</dd>
                        <dt>Delivered by</dt><dd>@Model.DeliveryHub</dd>
                        <dt>Item</dt>
                        <dd>
                            @(Model.ItemDescription ?? "—") · @Money.Kg(Model.BilledWeightGrams)
                            @if (Model.MeasuredWeightGrams is not null && Model.MeasuredWeightGrams != Model.WeightGrams)
                            {
                                <div class="cell-sub">weighed at the hub; you booked it as @Money.Kg(Model.WeightGrams)</div>
                            }
                        </dd>
                        @if (Model.MerchantReference is not null)
                        {
                            <dt>Invoice</dt><dd>@Model.MerchantReference</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        @if (Model.DeliveryAttempts.Count > 0)
        {
            <div class="card">
                <div class="card-head"><h3>@Icons.Get("bike") Delivery attempts</h3></div>
                <div class="table-wrap">
                    <table class="table compact">
                        <thead><tr><th>Handed to rider</th><th>Rider</th><th>Outcome</th><th class="num">Collected</th><th>Reason</th></tr></thead>
                        <tbody>
                            @foreach (var attempt in Model.DeliveryAttempts)
                            {
                                <tr>
                                    <td class="nowrap">@attempt.Assigned.ToString("d MMM, h:mm tt")</td>
                                    <td>@attempt.Rider <div class="cell-sub">@Money.Phone(attempt.RiderPhone)</div></td>
                                    <td>@Statuses.Badge(attempt.Outcome)</td>
                                    <td class="num">@Money.Taka(attempt.Collected)</td>
                                    <td>@(attempt.Reason ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="stack">
        <div class="card">
            <div class="card-head"><h3>@Icons.Get("cash") Money</h3></div>
            <div class="card-body">
                <div class="money-list">
                    <div><span class="muted">Cash on delivery</span><strong>@Money.Taka(Model.CodAmount)</strong></div>
                    @if (Model.PaidOnline is { } paidOnline)
                    {
                        <div class="sub"><span class="muted">paid online by the recipient</span><span class="positive">@Money.Taka(paidOnline)</span></div>
                    }
                    @if (Model.CollectedAmount is { } collected)
                    {
                        <div><span class="muted">Collected</span><strong class="positive">@Money.Taka(collected)</strong></div>
                    }
                    <div><span class="muted">Delivery charge (@Model.ServiceArea.DisplayName())</span><span>@Money.Taka(Model.DeliveryCharge)</span></div>
                    @if (Model.SpeedCharge > 0)
                    {
                        <div class="sub"><span class="muted">incl. @Model.SpeedName.ToLowerInvariant()</span><span>@Money.Taka(Model.SpeedCharge)</span></div>
                    }
                    @if (Model.ProductCharge > 0)
                    {
                        <div class="sub"><span class="muted">incl. @Model.ProductName.ToLowerInvariant()</span><span>@Money.Taka(Model.ProductCharge)</span></div>
                    }
                    <div><span class="muted">COD charge (@Model.CodChargePercent.ToString("0.##")%)</span><span>@Money.Taka(Model.CodCharge)</span></div>
                    @if (Model.Status is ParcelStatus.Returning or ParcelStatus.Returned)
                    {
                        <div><span class="muted">Return charge</span><span>@Money.Taka(Model.ReturnCharge)</span></div>
                    }
                    <div class="total"><span>Total charge</span><span>@Money.Taka(Model.TotalCharge)</span></div>
                </div>
                @if (Model.PayoutNumber is not null)
                {
                    <p class="muted mt mb-0">Paid out in @Model.PayoutNumber.</p>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-head"><h3>@Icons.Get("clock") Tracking history</h3></div>
            <div class="card-body">
                <ol class="timeline">
                    @foreach (var e in Model.Events.Reverse())
                    {
                        <li>
                            <span class="dot"></span>
                            <div class="tl-title">@e.Note</div>
                            <div class="tl-meta">@e.When.ToString("ddd d MMM, h:mm tt")@(e.Hub is null ? "" : $" · {e.Hub}")</div>
                        </li>
                    }
                </ol>
            </div>
        </div>
    </div>
</div>
