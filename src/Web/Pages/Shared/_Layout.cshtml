@inject ITenantContext TenantContext
@{
    var tenant = TenantContext.Tenant;
    var signedIn = Context.User.Identity?.IsAuthenticated == true;
    var name = tenant?.Name ?? "OneDrop";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f7fa" />
    <title>@ViewData["Title"] · @name</title>
    <link rel="icon" href="~/icons/icon.svg" type="image/svg+xml" />
    <partial name="_Fonts" />
    @* The public pages' headings *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header class="site-header">
        <div class="site-header-inner">
            <a class="site-brand" href="/">
                <partial name="_BrandMark" />
                @name
            </a>
            @if (tenant is not null)
            {
                <nav class="site-nav" aria-label="Main">
                    <a href="/#how">How it works</a>
                    <a href="/#pricing">Pricing</a>
                    <a asp-page="/Coverage">Coverage</a>
                    <a asp-page="/Track">Track a parcel</a>
                </nav>
            }
            <div class="site-actions">
                @if (signedIn)
                {
                    <a class="btn btn-primary" href="/">Go to my panel @Icons.Get("arrow-right")</a>
                }
                else
                {
                    <a class="btn btn-ghost" asp-page="/Account/Login">Sign in</a>
                    @if (tenant is not null)
                    {
                        <a class="btn btn-primary" asp-page="/Account/Register">Become a merchant</a>
                    }
                }
            </div>
        </div>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="site-footer-inner">
            @if (tenant is not null)
            {
                <div class="footer-grid">
                    <div>
                        <a class="site-brand" href="/">
                            <partial name="_BrandMark" />
                            @name
                        </a>
                        <p>Doorstep delivery and cash on delivery across Bangladesh, with the cash paid to the shop the next day.</p>
                    </div>
                    <div>
                        <h4>Send</h4>
                        <a asp-page="/Account/Register">Become a merchant</a>
                        <a href="/#pricing">Pricing</a>
                        <a asp-page="/Coverage">Coverage</a>
                        <a asp-page="/Account/Login">Merchant sign in</a>
                    </div>
                    <div>
                        <h4>Receive</h4>
                        <a asp-page="/Track">Track a parcel</a>
                        <a href="/#how">How delivery works</a>
                    </div>
                    <div>
                        <h4>Talk to us</h4>
                        <a href="tel:@tenant.SupportPhone">Hotline @tenant.SupportPhone</a>
                    </div>
                </div>
            }
            <div class="footer-bottom">
                <span>© @DateTime.UtcNow.Year @name</span>
                <span>Doorstep delivery and cash on delivery across Bangladesh</span>
                <span>Developed by <a class="credit-link" href="https://octopi-digital.com/" target="_blank" rel="noopener">Octopi Digital</a></span>
            </div>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
