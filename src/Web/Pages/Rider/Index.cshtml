@page
@using Domain.Delivery
@model Web.Pages.Rider.IndexModel
@{
    ViewData["Title"] = "My deliveries";
    var t = Model.Today!;
    var total = t.Deliveries.Count + t.Done.Count;
    var percent = total == 0 ? 0 : 100 * t.Done.Count / total;

    // The round in the order it is worked: collect from the merchants first, then the doors
    var stops = new List<string>();
    stops.AddRange(t.Pickups.Select(p => MapLinks.Stop(p.Pin, p.Address, p.Area)));
    stops.AddRange(t.Deliveries.Select(d => MapLinks.Stop(d.Pin, d.RecipientAddress, d.Area)));
    var route = MapLinks.Route(stops);
}
@section Head {
    <partial name="_RiderApp" />
}

<div class="rider-wrap">
    <div class="page-head">
        <div>
            <div class="page-kicker">@Icons.Get("warehouse") @t.Hub · @t.Date.ToString("dddd d MMMM")</div>
            <h1>Hello, @t.Rider</h1>
            <span class="vehicle">@Icons.Get(Statuses.Icon(t.Vehicle)) @t.Vehicle.DisplayName()</span>
        </div>
    </div>

    <partial name="_Alerts" />

    <div class="cash-card">
        <div>
            <div class="label">Cash in hand</div>
            <div class="value">@Money.Taka(t.CashInHand)</div>
        </div>
        <div class="text-right">
            <div class="label">To deliver</div>
            <div class="value">@t.Deliveries.Count</div>
        </div>
    </div>

    @if (total > 0)
    {
        <div class="day-progress">
            <div class="spread"><span>@t.Done.Count of @total done today</span><span>@percent%</span></div>
            <div class="meter"><span style="width:@percent%"></span></div>
            @if (t.DueBack is { } back && (t.Deliveries.Count > 0 || t.CashInHand > 0))
            {
                <div class="hint">@Icons.Get("clock") Back at the hub by <strong>@back.ToString("h:mm tt")</strong> with the cash and any parcel you could not deliver.</div>
            }
        </div>
    }

    @if (route is not null)
    {
        <a class="route-card" href="@route" target="_blank" rel="noopener">
            <span class="stat-icon">@Icons.Get("navigation")</span>
            <span class="route-text">
                <strong>See today's route on the map</strong>
                <span>
                    @stops.Count stop@(stops.Count == 1 ? "" : "s") in the order you work them, from where you are now@(t.Pickups.Count > 0 ? ": pickups first, then the doors" : "").
                    @if (stops.Count > MapLinks.MaxRouteStops)
                    {
                        <text>Google shows the first @MapLinks.MaxRouteStops; open it again from the next stop for the rest.</text>
                    }
                </span>
            </span>
            @Icons.Get("arrow-right")
        </a>
    }

    @if (t.Pickups.Count > 0)
    {
        <a class="alert alert-info" asp-page="/Rider/Pickups">@Icons.Get("truck")<div><strong>@t.Pickups.Count pickup@(t.Pickups.Count == 1 ? "" : "s") to make.</strong> Open your pickups.</div></a>
    }

    @if (Model.Returns.Count > 0)
    {
        <h4 class="mb">Returns to hand back</h4>
        @foreach (var r in Model.Returns)
        {
            var l = r.List;
            <div class="task">
                <div class="task-head">
                    <div>
                        <div class="task-name">@l.Merchant</div>
                        <div class="mono muted" style="font-size:12.5px">@l.Number · @l.PickupPoint</div>
                    </div>
                    <div class="text-right"><div class="task-cod">@l.Parcels</div><div class="muted" style="font-size:12px">parcel@(l.Parcels == 1 ? "" : "s")</div></div>
                </div>
                <div class="task-meta">
                    <div>@Icons.Get("map-pin") <span>@l.Address</span></div>
                    <div>@Icons.Get("phone") <a href="tel:@Money.Phone(l.Phone)">@Money.Phone(l.Phone)</a></div>
                </div>
                <div class="task-actions">
                    <a class="btn btn-primary" asp-page="/Rider/Return" asp-route-number="@l.Number">@Icons.Get("check") Record the hand-over</a>
                    <a class="btn btn-outline" href="tel:@Money.Phone(l.Phone)">@Icons.Get("phone") Call</a>
                </div>
            </div>
        }
    }

    <h4 class="mb">To deliver</h4>
    @if (t.Deliveries.Count == 0)
    {
        <div class="card">
            <div class="empty">
                @Icons.Get("check-circle")
                <h3>@(t.Done.Count > 0 ? "All done for now" : "Nothing to deliver")</h3>
                <p>@(t.Done.Count > 0 ? "Bring the cash and any parcel you could not deliver to the hub." : "The hub hands you parcels for your run.")</p>
            </div>
        </div>
    }
    @foreach (var d in t.Deliveries)
    {
        var place = $"{d.RecipientAddress}, {d.Area}";
        <div class="task @(d.Attempts > 0 ? "retry" : "")">
            <div class="task-head">
                <div>
                    <div class="task-name">@d.RecipientName</div>
                    <div class="mono muted" style="font-size:12.5px">@d.TrackingCode · @d.Merchant</div>
                </div>
                <div class="text-right">
                    <div class="task-cod">@Money.Taka(d.CodAmount)</div>
                    <div class="muted" style="font-size:12px">@(d.CodAmount == 0 ? "already paid" : "to collect")</div>
                </div>
            </div>
            @if (d.Tags.Any)
            {
                <div class="tag-row">@Statuses.Tags(d.Tags)</div>
            }
            <div class="task-meta">
                <div>@Icons.Get("map-pin") <span>@d.RecipientAddress, <strong>@d.Area</strong></span></div>
                <div>@Icons.Get("phone") <a href="tel:@Money.Phone(d.RecipientPhone)">@Money.Phone(d.RecipientPhone)</a></div>
                @if (d.Note is not null)
                {
                    <div>@Icons.Get("message") <span>@d.Note</span></div>
                }
                @if (d.Attempts > 0)
                {
                    <div class="row-note">@Icons.Get("refresh") <span>Attempt @(d.Attempts + 1) of @d.MaxAttempts</span></div>
                }
                @if (d.DueOn < t.Date)
                {
                    <div>@Statuses.Due(d.DueOn, Domain.Parcels.ParcelStatus.OutForDelivery, t.Date)</div>
                }
            </div>
            <div class="task-actions">
                <a class="btn btn-primary" asp-page="/Rider/Delivery" asp-route-code="@d.TrackingCode">@Icons.Get("check") Record outcome</a>
                <a class="btn btn-outline" href="tel:@Money.Phone(d.RecipientPhone)">@Icons.Get("phone") Call</a>
                @if (d.Pin is { } door)
                {
                    <a class="btn btn-outline" href="@MapLinks.Directions(door)" target="_blank" rel="noopener">@Icons.Get("navigation") Navigate</a>
                }
                else
                {
                    <a class="btn btn-outline" href="@MapLinks.Search(place)" target="_blank" rel="noopener">@Icons.Get("map-pin") Map</a>
                }
            </div>
        </div>
    }

    @if (t.Done.Count > 0)
    {
        <h4 class="mb mt-lg">Done today</h4>
        <div class="card">
            <div class="table-wrap">
                <table class="table compact">
                    <tbody>
                        @foreach (var done in t.Done)
                        {
                            <tr>
                                <td><div class="cell-main">@done.RecipientName</div><div class="cell-sub mono">@done.TrackingCode · @done.Area</div></td>
                                <td>@Statuses.Badge(done.Outcome)</td>
                                <td class="num">@Money.Taka(done.Collected)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <p class="hint mt">Bring the parcels you could not deliver and the cash to the hub at the end of your run.</p>
    }
</div>
