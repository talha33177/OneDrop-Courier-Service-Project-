@page "{code}"
@model Web.Pages.Rider.DeliveryModel
@inject ITenantContext TenantContext
@inject MapsOptions Maps
@{
    ViewData["Title"] = Model.Parcel.TrackingCode;
    var d = Model.Parcel;
    var lastAttempt = d.Attempts + 1 >= d.MaxAttempts;
    var tomorrow = TenantContext.Require().Today(DateTime.UtcNow).AddDays(1);
    var place = $"{d.RecipientAddress}, {d.Area}";
}
@section Head {
    <partial name="_RiderApp" />
}

<div class="rider-wrap">
    <div class="breadcrumb"><a asp-page="/Rider/Index">@Icons.Get("arrow-left") My deliveries</a></div>
    <div class="task mb @(d.Attempts > 0 ? "retry" : "")">
        <div class="task-head">
            <div>
                <div class="task-name">@d.RecipientName</div>
                <div class="mono muted" style="font-size:12.5px">@d.TrackingCode · @d.Merchant (@Money.Phone(d.MerchantPhone))</div>
            </div>
            <div class="text-right"><div class="task-cod">@Money.Taka(d.CodAmount)</div><div class="muted" style="font-size:12px">@(d.CodAmount == 0 ? "already paid" : "to collect")</div></div>
        </div>
        @if (d.Tags.Any)
        {
            <div class="tag-row">@Statuses.Tags(d.Tags)</div>
            @if (d.Tags.Handling is { } handling)
            {
                <p class="handling">@handling</p>
            }
        }
        <div class="task-meta">
            <div>@Icons.Get("map-pin") <span>@d.RecipientAddress, <strong>@d.Area</strong></span></div>
            <div>@Icons.Get("phone") <a href="tel:@Money.Phone(d.RecipientPhone)">@Money.Phone(d.RecipientPhone)</a></div>
            <div>@Icons.Get("package") <span>@(d.ItemDescription ?? "Parcel") · @Money.Kg(d.WeightGrams)</span></div>
            @if (d.Note is not null)
            {
                <div>@Icons.Get("message") <span>@d.Note</span></div>
            }
        </div>
        @if (d.Pin is { } pin && Maps.Configured)
        {
            <iframe class="map-embed" title="The door on the map" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="@MapLinks.Embed(Maps.ApiKey!, pin)"></iframe>
        }
        <div class="task-actions">
            <a class="btn btn-outline" href="tel:@Money.Phone(d.RecipientPhone)">@Icons.Get("phone") Call</a>
            @if (d.Pin is { } door)
            {
                <a class="btn btn-primary" href="@MapLinks.Directions(door)" target="_blank" rel="noopener">@Icons.Get("navigation") Navigate</a>
            }
            else
            {
                <a class="btn btn-outline" href="@MapLinks.Search(place)" target="_blank" rel="noopener">@Icons.Get("map-pin") Map</a>
            }
        </div>
        @if (d.Pin is not null)
        {
            <p class="hint">The merchant pinned the door: Navigate opens Google Maps with directions to it.</p>
        }
    </div>

    @if (Model.Problem is not null)
    {
        <div class="alert alert-error">@Icons.Get("alert")<div>@Model.Problem</div></div>
    }

    <h4 class="mb">What happened at the door?</h4>
    <div class="outcome-forms">
        <details open>
            <summary><span class="stat-icon green">@Icons.Get("check")</span> Delivered</summary>
            <div class="body">
                <form method="post" asp-page-handler="Deliver" asp-route-code="@d.TrackingCode">
                    <div class="field">
                        <label for="collected">Cash collected</label>
                        <div class="input-group">
                            <span class="prefix">৳</span>
                            <input type="number" id="collected" name="collected" value="@d.CodAmount.ToString("0")" min="0" max="@d.CodAmount.ToString("0")" step="1" inputmode="numeric" required data-cod="@d.CodAmount.ToString("0")" />
                        </div>
                        <span class="hint">Less than @Money.Taka(d.CodAmount) only if the customer kept part of the parcel; then say why.</span>
                    </div>
                    <div class="field" data-partly>
                        <label for="deliverReason">Reason, for a partial delivery</label>
                        <input type="text" id="deliverReason" name="reason" maxlength="200" placeholder="e.g. Kept 2 of 3 items" />
                    </div>
                    <button class="btn btn-primary btn-lg btn-block" type="submit" data-deliver>@Icons.Get("check") Delivered</button>
                </form>
            </div>
        </details>
        @if (!lastAttempt)
        {
            <details>
                <summary><span class="stat-icon orange">@Icons.Get("pause")</span> Not today (hold)</summary>
                <div class="body">
                    <form method="post" asp-page-handler="Hold" asp-route-code="@d.TrackingCode">
                        <div class="field">
                            <label for="holdReason">Why</label>
                            <select id="holdReason" name="reason" required>
                                <option>Customer not reachable</option>
                                <option>Customer asked for another day</option>
                                <option>Customer not at the address</option>
                                <option>Address not found</option>
                            </select>
                        </div>
                        <div class="field">
                            <label for="until">Deliver on (if the customer said)</label>
                            <input type="date" id="until" name="until" min="@tomorrow.ToString("yyyy-MM-dd")" />
                            <span class="hint">You bring the parcel back to the hub; it goes out again on that day. This is attempt @(d.Attempts + 1) of @d.MaxAttempts.</span>
                        </div>
                        <button class="btn btn-outline btn-lg btn-block" type="submit">@Icons.Get("pause") Put on hold</button>
                    </form>
                </div>
            </details>
        }
        <details>
            <summary><span class="stat-icon red">@Icons.Get("x")</span> Refused</summary>
            <div class="body">
                <form method="post" asp-page-handler="Refuse" asp-route-code="@d.TrackingCode"
                      data-confirm="The parcel goes back to @d.Merchant and cannot be delivered again." data-confirm-title="Return this parcel?" data-confirm-ok="Yes, return it">
                    <div class="field">
                        <label for="refuseReason">Why</label>
                        <select id="refuseReason" name="reason" required>
                            <option>Customer refused the parcel</option>
                            <option>Customer did not order it</option>
                            <option>Wrong or damaged product</option>
                            <option>Customer cannot pay</option>
                            @if (lastAttempt)
                            {
                                <option>Not delivered after every attempt</option>
                            }
                        </select>
                    </div>
                    <button class="btn btn-danger btn-lg btn-block" type="submit">@Icons.Get("return") Return to merchant</button>
                </form>
            </div>
        </details>
    </div>
    @if (lastAttempt)
    {
        <div class="alert alert-warning mt">@Icons.Get("alert")<div>This is the last attempt: the parcel is delivered or goes back to the merchant.</div></div>
    }
</div>

@section Scripts {
    <script>
    (() => {
        // The reason is asked for only when less than the cash on delivery was collected
        const collected = document.getElementById("collected");
        const partly = document.querySelector("[data-partly]");
        const reason = partly.querySelector("input");
        const button = document.querySelector("[data-deliver]");
        const label = button.lastChild;
        const check = () => {
            const short = collected.value !== "" && Number(collected.value) < Number(collected.dataset.cod);
            partly.hidden = !short;
            reason.required = short;
            label.textContent = short ? " Partly delivered" : " Delivered";
        };
        collected.addEventListener("input", check);
        check();

        // One outcome open at a time
        const all = document.querySelectorAll(".outcome-forms details");
        all.forEach(details => details.addEventListener("toggle", () => {
            if (details.open) {
                all.forEach(other => other !== details && other.removeAttribute("open"));
            }
        }));
    })();
    </script>
}
