@page
@model Web.Pages.Rider.PickupsModel
@{
    ViewData["Title"] = "My pickups";
    var t = Model.Today!;
    var stops = t.Pickups.Select(p => MapLinks.Stop(p.Pin, p.Address, p.Area)).ToList();
    var route = MapLinks.Route(stops);
}
@section Head {
    <partial name="_RiderApp" />
}

<div class="rider-wrap">
    <div class="page-head">
        <div>
            <h1>My pickups</h1>
            <p>Collect the parcels at each merchant and tick the ones you take. You visit each merchant once a day: reload the list at the door to see parcels booked a moment ago, because what the merchant books after you leave waits for tomorrow.</p>
        </div>
    </div>

    <partial name="_Alerts" />

    @if (route is not null)
    {
        <a class="route-card" href="@route" target="_blank" rel="noopener">
            <span class="stat-icon">@Icons.Get("navigation")</span>
            <span class="route-text">
                <strong>See your pickup round on the map</strong>
                <span>
                    @stops.Count merchant@(stops.Count == 1 ? "" : "s") in the order you collect, from where you are now.
                    @if (stops.Count > MapLinks.MaxRouteStops)
                    {
                        <text>Google shows the first @MapLinks.MaxRouteStops; open it again from the next stop for the rest.</text>
                    }
                </span>
            </span>
            @Icons.Get("arrow-right")
        </a>
    }

    @if (t.Pickups.Count == 0)
    {
        <div class="card"><div class="empty">@Icons.Get("truck")<h3>No pickups</h3><p>The hub assigns pickups to you.</p></div></div>
    }
    @foreach (var p in t.Pickups)
    {
        <div class="task">
            <div class="task-head">
                <div>
                    <div class="task-name">@p.Merchant</div>
                    <div class="muted" style="font-size:12.5px">@p.PickupPoint · @p.Date.ToString("ddd d MMM") · @p.Parcels.Count parcel@(p.Parcels.Count == 1 ? "" : "s")</div>
                </div>
            </div>
            <div class="task-meta">
                <div>@Icons.Get("map-pin") <span>@p.Address, <strong>@p.Area</strong></span></div>
                <div>@Icons.Get("phone") <a href="tel:@Money.Phone(p.ContactPhone)">@Money.Phone(p.ContactPhone)</a></div>
            </div>
            <div class="task-actions">
                <a class="btn btn-outline" href="tel:@Money.Phone(p.ContactPhone)">@Icons.Get("phone") Call</a>
                @if (p.Pin is { } door)
                {
                    <a class="btn btn-outline" href="@MapLinks.Directions(door)" target="_blank" rel="noopener">@Icons.Get("navigation") Navigate</a>
                }
                else
                {
                    <a class="btn btn-outline" href="@MapLinks.Search($"{p.Address}, {p.Area}, Bangladesh")" target="_blank" rel="noopener">@Icons.Get("map-pin") Map</a>
                }
            </div>
            <form method="post" asp-route-id="@p.Id">
                @foreach (var parcel in p.Parcels)
                {
                    <input type="hidden" name="shown" value="@parcel.TrackingCode" />
                }
                @if (p.Parcels.Count == 0)
                {
                    <p class="muted">Nothing left to collect here: the merchant's parcels were cancelled or brought to the hub.</p>
                }
                else
                {
                    <div class="stack" style="margin-top:8px">
                        @foreach (var parcel in p.Parcels)
                        {
                            <label class="check" style="font-weight:500">
                                <input type="checkbox" name="codes" value="@parcel.TrackingCode" checked />
                                <span><span class="mono strong">@parcel.TrackingCode</span> · @parcel.RecipientName, @parcel.Area · @Money.Taka(parcel.CodAmount)</span>
                            </label>
                        }
                    </div>
                }
                <button class="btn btn-primary btn-block mt" type="submit">@Icons.Get("check") Picked up</button>
            </form>
        </div>
    }
</div>
