@page
@model Web.Pages.Dev.EmailsModel
@{
    ViewData["Title"] = "Email outbox";
}

<div class="page-head">
    <div>
        <h1>Email outbox</h1>
        <p>
            Development only. The last 500 emails sent, each drawn as the mail app shows it.
            @if (Model.Live)
            {
                <strong>A mail server is configured, so these were really sent.</strong>
            }
            else
            {
                <text>No mail server is configured, so they were kept here instead of being sent.</text>
            }
        </p>
    </div>
</div>

@if (Model.Done is not null)
{
    <div class="alert alert-success" role="status">@Icons.Get("check-circle")<div>@Model.Done</div></div>
}
@if (Model.Problem is not null)
{
    <div class="alert alert-error" role="alert">@Icons.Get("alert")<div>The mail server refused it: @Model.Problem</div></div>
}

<form method="post" asp-page-handler="Test" class="mb">
    <button type="submit" class="btn btn-primary">@Icons.Get("message") Send a test email@(Model.MailServer is { Length: > 0 } host ? " through " + host : "")</button>
</form>

<div class="card">
    @if (Model.Messages.Count == 0)
    {
        <div class="empty">@Icons.Get("message")<h3>No emails yet</h3><p>Emails go out when a shop signs up, is approved, is paid, gets an answer, has returns to confirm or pays online, and when someone asks for a new password.</p></div>
    }
    else
    {
        <div class="card-body">
            @foreach (var (message, index) in Model.Messages.Select((m, i) => (m, i)))
            {
                <details class="mb" open="@(index == 0)">
                    <summary style="cursor:pointer;padding:6px 0">
                        <strong>@message.Subject</strong>
                        <span class="muted"> · to @message.To · @message.On.ToString("HH:mm:ss") UTC</span>
                    </summary>
                    @* Drawn as the mail app draws it, in a box with no scripts *@
                    <iframe sandbox title="@message.Subject" srcdoc="@message.Html" style="width:100%;height:760px;border:1px solid var(--line);border-radius:12px;background:#fff;margin-top:8px"></iframe>
                </details>
            }
        </div>
    }
</div>
